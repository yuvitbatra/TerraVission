---
/**
 * GlassCard — translucent frosted-glass container.
 *
 * Props
 *   as?     – HTML element to render (default: "div")
 *   class?  – extra utility classes to merge in
 *   strong? – use .glass-strong instead of .glass
 */
interface Props {
  as?: string;
  class?: string;
  strong?: boolean;
}

const { as: Tag = "div", class: className, strong = false } = Astro.props;
const glassClass = strong ? "glass-strong" : "glass";
---

<Tag class:list={["gc", glassClass, className]}>
  <slot />
</Tag>

<style>
  .gc {
    padding: clamp(1.25rem, 3vw, 2rem);
  }
</style>
