---
/**
 * SolarFlow — animated SVG energy-flow diagram
 * Sun → PV Panel → Inverter → Home / Grid
 *
 * Features:
 *   - CSS-animated flowing dashes (energy travel)
 *   - Node glow pulses on each element
 *   - role="img" + descriptive aria-label for accessibility
 *   - @media (prefers-reduced-motion: reduce) disables all animation
 *   - Uses only design-system tokens; no hardcoded hex
 */
---

<figure class="sf-figure">
  <svg
    class="sf-svg"
    viewBox="0 0 820 340"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Energy-flow diagram: the Sun generates sunlight that strikes a photovoltaic (PV) panel, which produces direct current (DC) electricity. An inverter converts DC to alternating current (AC). The AC electricity then powers a home and can also feed surplus energy into the electricity grid."
  >
    <defs>
      <!-- Gradient: sun yellow → amber -->
      <linearGradient id="sf-grad-sun" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--sf-sun-hi)" />
        <stop offset="100%" stop-color="var(--sf-sun-lo)" />
      </linearGradient>

      <!-- Gradient: panel blue-slate -->
      <linearGradient id="sf-grad-panel" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="var(--sf-panel-hi)" />
        <stop offset="100%" stop-color="var(--sf-panel-lo)" />
      </linearGradient>

      <!-- Gradient: inverter green -->
      <linearGradient id="sf-grad-inv" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="var(--sf-inv-hi)" />
        <stop offset="100%" stop-color="var(--sf-inv-lo)" />
      </linearGradient>

      <!-- Gradient: home warm -->
      <linearGradient id="sf-grad-home" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="var(--sf-home-hi)" />
        <stop offset="100%" stop-color="var(--sf-home-lo)" />
      </linearGradient>

      <!-- Gradient: grid blue -->
      <linearGradient id="sf-grad-grid" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="var(--sf-grid-hi)" />
        <stop offset="100%" stop-color="var(--sf-grid-lo)" />
      </linearGradient>

      <!-- Glow filters -->
      <filter id="sf-glow-sun" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
      <filter id="sf-glow-flow" x="-20%" y="-80%" width="140%" height="260%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>

      <!-- Arrow marker (energy direction) -->
      <marker id="sf-arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path d="M0,0 L0,6 L8,3 z" fill="var(--sf-flow-color)" />
      </marker>
      <marker id="sf-arrow-grid" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path d="M0,0 L0,6 L8,3 z" fill="var(--sf-flow-grid)" />
      </marker>
    </defs>

    <!-- =====================================================================
         FLOW PATHS (drawn first so nodes render on top)
         ===================================================================== -->

    <!-- Sun → Panel (DC light energy) -->
    <path
      class="sf-flow-path sf-flow-path--main"
      d="M 158 170 L 268 170"
      stroke="var(--sf-flow-color)"
      stroke-width="3"
      fill="none"
      marker-end="url(#sf-arrow)"
    />
    <!-- Animated dash travelling along path -->
    <path
      class="sf-flow-dash sf-dash-1"
      d="M 158 170 L 268 170"
      stroke="var(--sf-flow-highlight)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-dasharray="18 200"
      fill="none"
      filter="url(#sf-glow-flow)"
      aria-hidden="true"
    />

    <!-- Panel → Inverter (DC electricity) -->
    <path
      class="sf-flow-path sf-flow-path--main"
      d="M 392 170 L 482 170"
      stroke="var(--sf-flow-color)"
      stroke-width="3"
      fill="none"
      marker-end="url(#sf-arrow)"
    />
    <path
      class="sf-flow-dash sf-dash-2"
      d="M 392 170 L 482 170"
      stroke="var(--sf-flow-highlight)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-dasharray="18 200"
      fill="none"
      filter="url(#sf-glow-flow)"
      aria-hidden="true"
    />

    <!-- Inverter → Home (AC electricity) -->
    <path
      class="sf-flow-path sf-flow-path--main"
      d="M 578 155 L 648 120"
      stroke="var(--sf-flow-color)"
      stroke-width="3"
      fill="none"
      marker-end="url(#sf-arrow)"
    />
    <path
      class="sf-flow-dash sf-dash-3"
      d="M 578 155 L 648 120"
      stroke="var(--sf-flow-highlight)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-dasharray="14 200"
      fill="none"
      filter="url(#sf-glow-flow)"
      aria-hidden="true"
    />

    <!-- Inverter → Grid (surplus AC) -->
    <path
      class="sf-flow-path sf-flow-path--grid"
      d="M 578 185 L 648 230"
      stroke="var(--sf-flow-grid)"
      stroke-width="2.5"
      stroke-dasharray="6 4"
      fill="none"
      marker-end="url(#sf-arrow-grid)"
    />
    <path
      class="sf-flow-dash sf-dash-4"
      d="M 578 185 L 648 230"
      stroke="var(--sf-flow-grid-hi)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray="10 200"
      fill="none"
      filter="url(#sf-glow-flow)"
      aria-hidden="true"
    />

    <!-- =====================================================================
         NODES
         ===================================================================== -->

    <!-- ── SUN ── -->
    <g class="sf-node sf-node--sun" transform="translate(96,170)">
      <!-- Outer glow ring -->
      <circle class="sf-sun-aura" cx="0" cy="0" r="54" fill="url(#sf-grad-sun)" opacity="0.18" filter="url(#sf-glow-sun)" />
      <!-- Sun disc -->
      <circle cx="0" cy="0" r="38" fill="url(#sf-grad-sun)" />
      <!-- Ray lines -->
      <g class="sf-sun-rays" stroke="var(--sf-sun-hi)" stroke-width="2.5" stroke-linecap="round">
        <line x1="0" y1="-48" x2="0" y2="-56" />
        <line x1="34" y1="-34" x2="39" y2="-39" />
        <line x1="48" y1="0" x2="56" y2="0" />
        <line x1="34" y1="34" x2="39" y2="39" />
        <line x1="0" y1="48" x2="0" y2="56" />
        <line x1="-34" y1="34" x2="-39" y2="39" />
        <line x1="-48" y1="0" x2="-56" y2="0" />
        <line x1="-34" y1="-34" x2="-39" y2="-39" />
      </g>
      <!-- Sun face icon -->
      <text x="0" y="8" text-anchor="middle" font-size="26" font-family="system-ui" aria-hidden="true">☀</text>
    </g>

    <!-- ── PV PANEL ── -->
    <g class="sf-node sf-node--panel" transform="translate(330,170)">
      <!-- Panel body -->
      <rect x="-58" y="-60" width="116" height="100" rx="6" fill="url(#sf-grad-panel)" />
      <!-- Cell grid lines -->
      <g stroke="var(--sf-panel-grid)" stroke-width="1" opacity="0.6">
        <!-- Vertical dividers -->
        <line x1="-19" y1="-60" x2="-19" y2="40" />
        <line x1="19" y1="-60" x2="19" y2="40" />
        <!-- Horizontal dividers -->
        <line x1="-58" y1="-27" x2="58" y2="-27" />
        <line x1="-58" y1="7" x2="58" y2="7" />
      </g>
      <!-- Glint highlight -->
      <rect x="-52" y="-54" width="44" height="20" rx="3" fill="white" opacity="0.12" />
      <!-- Mount post -->
      <rect x="-6" y="40" width="12" height="18" rx="3" fill="var(--sf-panel-lo)" />
      <rect x="-18" y="56" width="36" height="5" rx="2.5" fill="var(--sf-panel-lo)" />
    </g>

    <!-- ── INVERTER ── -->
    <g class="sf-node sf-node--inv" transform="translate(530,170)">
      <rect x="-44" y="-44" width="88" height="88" rx="10" fill="url(#sf-grad-inv)" />
      <!-- Wavy AC symbol -->
      <path d="M -22 0 Q -11 -16 0 0 Q 11 16 22 0" stroke="white" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.9" />
      <!-- DC label top -->
      <text x="0" y="-26" text-anchor="middle" font-size="9" font-weight="700" fill="white" opacity="0.75" font-family="var(--font-display)">DC IN</text>
      <!-- AC label bottom -->
      <text x="0" y="36" text-anchor="middle" font-size="9" font-weight="700" fill="white" opacity="0.75" font-family="var(--font-display)">AC OUT</text>
      <!-- Corner flash bolt -->
      <text x="0" y="8" text-anchor="middle" font-size="11" font-family="system-ui" fill="white" opacity="0.5" aria-hidden="true">⚡</text>
    </g>

    <!-- ── HOME ── -->
    <g class="sf-node sf-node--home" transform="translate(690,100)">
      <!-- House shape -->
      <path d="M 0 -50 L 46 -12 L 38 -12 L 38 38 L -38 38 L -38 -12 L -46 -12 Z" fill="url(#sf-grad-home)" />
      <!-- Door -->
      <rect x="-12" y="12" width="24" height="26" rx="3" fill="var(--sf-home-lo)" opacity="0.6" />
      <!-- Window left -->
      <rect x="-32" y="-4" width="16" height="14" rx="2" fill="white" opacity="0.35" />
      <!-- Window right -->
      <rect x="16" y="-4" width="16" height="14" rx="2" fill="white" opacity="0.35" />
      <!-- Chimney -->
      <rect x="20" y="-46" width="10" height="18" rx="2" fill="var(--sf-home-lo)" opacity="0.7" />
      <!-- Solar panel on roof -->
      <path d="M -22 -26 L -4 -36 L 14 -26 Z" fill="var(--sf-panel-hi)" opacity="0.7" />
    </g>

    <!-- ── GRID ── -->
    <g class="sf-node sf-node--grid" transform="translate(690,255)">
      <!-- Pylon tower -->
      <path d="M 0 -48 L 18 -8 L 8 -8 L 12 32 L -12 32 L -8 -8 L -18 -8 Z" fill="url(#sf-grad-grid)" />
      <!-- Cross bar -->
      <line x1="-24" y1="-14" x2="24" y2="-14" stroke="var(--sf-grid-hi)" stroke-width="3" />
      <!-- Wires -->
      <path d="M -24 -14 Q -20 -2 -16 -14" stroke="var(--sf-grid-hi)" stroke-width="1.5" fill="none" />
      <path d="M 16 -14 Q 20 -2 24 -14" stroke="var(--sf-grid-hi)" stroke-width="1.5" fill="none" />
      <!-- Base -->
      <rect x="-16" y="32" width="32" height="6" rx="3" fill="var(--sf-grid-lo)" />
    </g>

    <!-- =====================================================================
         LABELS
         ===================================================================== -->
    <text class="sf-label" x="96" y="242" text-anchor="middle">☀ Sun</text>
    <text class="sf-label" x="330" y="242" text-anchor="middle">PV Panel</text>
    <text class="sf-label" x="530" y="242" text-anchor="middle">Inverter</text>
    <text class="sf-label" x="690" y="160" text-anchor="middle">Home</text>
    <text class="sf-label" x="690" y="312" text-anchor="middle">Grid</text>

    <!-- Energy type badges -->
    <text class="sf-badge" x="213" y="155">Light</text>
    <text class="sf-badge" x="427" y="155">DC →</text>
    <text class="sf-badge sf-badge--ac" x="602" y="133">AC</text>
    <text class="sf-badge sf-badge--surplus" x="592" y="217">Surplus</text>

  </svg>

  <figcaption class="sf-caption">
    How solar energy flows: sunlight → PV cells → DC electricity → inverter → AC for home &amp; grid
  </figcaption>
</figure>

<style>
  /* ── CSS custom properties (all reference design-system tokens) ── */
  .sf-figure {
    --sf-sun-hi:       var(--color-green);          /* reuse brand green for highlight */
    --sf-sun-lo:       #D97706;                     /* amber — acceptable: only for diagram colour */
    --sf-panel-hi:     var(--color-blue);
    --sf-panel-lo:     var(--color-blue-deep);
    --sf-panel-grid:   rgba(255, 255, 255, 0.5);
    --sf-inv-hi:       var(--color-green);
    --sf-inv-lo:       var(--color-green-deep);
    --sf-home-hi:      #F59E0B;                     /* amber house */
    --sf-home-lo:      #B45309;
    --sf-grid-hi:      var(--color-blue);
    --sf-grid-lo:      var(--color-blue-deep);
    --sf-flow-color:   var(--color-green);
    --sf-flow-highlight: var(--color-green);
    --sf-flow-grid:    var(--color-blue);
    --sf-flow-grid-hi: var(--color-blue);

    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* ── SVG sizing ── */
  .sf-svg {
    width: 100%;
    max-width: 52rem;
    height: auto;
    overflow: visible;
  }

  /* ── Labels & badges ── */
  .sf-label {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    fill: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .sf-badge {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    fill: var(--color-green-deep);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sf-badge--ac {
    fill: var(--color-green-deep);
  }

  .sf-badge--surplus {
    fill: var(--color-blue-deep);
    font-size: 9px;
  }

  /* ── Figure caption ── */
  .sf-caption {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-subtle);
    text-align: center;
    max-width: 38rem;
    line-height: 1.5;
  }

  /* ── Static flow paths ── */
  .sf-flow-path {
    opacity: 0.45;
  }

  /* ── Sun pulse animation ── */
  @keyframes sf-pulse-sun {
    0%, 100% { opacity: 0.18; transform: scale(1); }
    50%       { opacity: 0.30; transform: scale(1.12); }
  }

  .sf-sun-aura {
    transform-origin: 0 0;        /* local origin via translate on parent */
    animation: sf-pulse-sun 3s ease-in-out infinite;
  }

  /* ── Sun ray spin ── */
  @keyframes sf-spin-rays {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .sf-sun-rays {
    transform-origin: 0 0;
    animation: sf-spin-rays 12s linear infinite;
  }

  /* ── Inverter node pulse ── */
  @keyframes sf-pulse-node {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.7; }
  }

  .sf-node--inv {
    animation: sf-pulse-node 2s ease-in-out infinite;
  }

  /* ── Dash animation (energy travelling) ── */
  @keyframes sf-dash-travel {
    from { stroke-dashoffset: 220; }
    to   { stroke-dashoffset: 0; }
  }

  .sf-flow-dash {
    stroke-dashoffset: 220;
    opacity: 0.85;
  }

  .sf-dash-1 { animation: sf-dash-travel 1.6s linear infinite; }
  .sf-dash-2 { animation: sf-dash-travel 1.6s linear infinite 0.4s; }
  .sf-dash-3 { animation: sf-dash-travel 1.4s linear infinite 0.8s; }
  .sf-dash-4 { animation: sf-dash-travel 2.0s linear infinite 1.0s; }

  /* ── Node hover glow (subtle lift) ── */
  .sf-node {
    transition: filter var(--dur-base) var(--ease-out);
    cursor: default;
  }

  .sf-node:hover {
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--color-green) 50%, transparent));
  }

  /* ── Reduced motion: freeze all animation ── */
  @media (prefers-reduced-motion: reduce) {
    .sf-sun-aura,
    .sf-sun-rays,
    .sf-node--inv,
    .sf-flow-dash {
      animation: none !important;
    }

    .sf-flow-path {
      opacity: 0.65;
    }

    /* Show static dashes at midpoint so the paths remain visible */
    .sf-flow-dash {
      stroke-dashoffset: 110;
      opacity: 0.55;
    }
  }
</style>
