---
/**
 * RecyclingCycle — animated circular SVG diagram showing the 5-step waste lifecycle.
 * Steps: Collect → Sort → Process → Manufacture → Reuse
 * Accessibility: role="img" + aria-label, reduced-motion safe.
 */
---

<div class="rc-wrap">
  <svg
    class="rc-svg"
    viewBox="0 0 400 400"
    role="img"
    aria-label="Animated recycling cycle diagram showing five stages: Collect, Sort, Process, Manufacture, and Reuse, connected in a continuous circular flow"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Gradient for track ring -->
      <linearGradient id="rc-ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--color-green)" stop-opacity="0.35" />
        <stop offset="100%" stop-color="var(--color-blue)" stop-opacity="0.35" />
      </linearGradient>

      <!-- Arrowhead marker — green -->
      <marker id="rc-arrow" markerWidth="8" markerHeight="8" refX="5" refY="3" orient="auto">
        <path d="M0,0 L0,6 L8,3 z" fill="var(--color-green)" />
      </marker>

      <!-- Clip for the rotating dashes -->
      <clipPath id="rc-circle-clip">
        <circle cx="200" cy="200" r="135" />
      </clipPath>
    </defs>

    <!-- ── Background glow ring ── -->
    <circle cx="200" cy="200" r="135" fill="none" stroke="url(#rc-ring-grad)" stroke-width="18" opacity="0.5" />

    <!-- ── Animated rotating dashes overlay ── -->
    <circle
      class="rc-dash-ring"
      cx="200" cy="200" r="135"
      fill="none"
      stroke="var(--color-green)"
      stroke-width="3"
      stroke-dasharray="18 22"
      stroke-linecap="round"
      opacity="0.6"
    />

    <!-- ── Five step nodes positioned on circle (r=135) ──
         Angles: Collect=270°(top), Sort=342°, Process=54°, Manufacture=126°, Reuse=198°
         x = 200 + 135*cos(θ), y = 200 + 135*sin(θ)
    -->

    <!-- Collect: top (270° = -90°) → (200, 65) -->
    <g class="rc-node rc-node--collect" transform="translate(200, 65)">
      <circle r="32" fill="var(--rc-collect)" opacity="0.15" />
      <circle r="32" fill="none" stroke="var(--rc-collect)" stroke-width="2" />
      <text class="rc-icon" text-anchor="middle" dominant-baseline="central" font-size="22">🗑️</text>
    </g>
    <text class="rc-label" x="200" y="22" text-anchor="middle">Collect</text>

    <!-- Sort: 342° → cos=-14°=~(332,110) approx. Let me recalculate properly.
         θ = 270 + 72*1 = 342° → rad=5.969 → cos=0.978, sin=-0.208 → (200+132, 200-28) = (332, 172)
    -->
    <g class="rc-node rc-node--sort" transform="translate(332, 172)">
      <circle r="32" fill="var(--rc-sort)" opacity="0.15" />
      <circle r="32" fill="none" stroke="var(--rc-sort)" stroke-width="2" />
      <text class="rc-icon" text-anchor="middle" dominant-baseline="central" font-size="22">♻️</text>
    </g>
    <text class="rc-label" x="381" y="176" text-anchor="middle">Sort</text>

    <!-- Process: 54° → cos=0.588, sin=0.809 → (200+79, 200+109) = (279, 309) -->
    <g class="rc-node rc-node--process" transform="translate(279, 309)">
      <circle r="32" fill="var(--rc-process)" opacity="0.15" />
      <circle r="32" fill="none" stroke="var(--rc-process)" stroke-width="2" />
      <text class="rc-icon" text-anchor="middle" dominant-baseline="central" font-size="22">⚙️</text>
    </g>
    <text class="rc-label" x="279" y="358" text-anchor="middle">Process</text>

    <!-- Manufacture: 126° → cos=-0.588, sin=0.809 → (200-79, 200+109) = (121, 309) -->
    <g class="rc-node rc-node--manufacture" transform="translate(121, 309)">
      <circle r="32" fill="var(--rc-manufacture)" opacity="0.15" />
      <circle r="32" fill="none" stroke="var(--rc-manufacture)" stroke-width="2" />
      <text class="rc-icon" text-anchor="middle" dominant-baseline="central" font-size="22">🏭</text>
    </g>
    <text class="rc-label" x="121" y="358" text-anchor="middle">Manufacture</text>

    <!-- Reuse: 198° → cos=-0.951, sin=-0.309 → (200-128, 200-42) = (72, 158) -->
    <!-- Actually 270+72*4=558=198° → cos(198°)=cos(180+18)=-cos18=-0.951, sin=-sin18=-0.309 -->
    <g class="rc-node rc-node--reuse" transform="translate(72, 158)">
      <circle r="32" fill="var(--rc-reuse)" opacity="0.15" />
      <circle r="32" fill="none" stroke="var(--rc-reuse)" stroke-width="2" />
      <text class="rc-icon" text-anchor="middle" dominant-baseline="central" font-size="22">🔄</text>
    </g>
    <text class="rc-label" x="24" y="162" text-anchor="middle">Reuse</text>

    <!-- ── Animated arrows between nodes ── -->
    <!-- Collect→Sort arc arrow approximated as a path near the ring -->
    <g class="rc-arrows" opacity="0.85">
      <!-- Arrow 1: Collect(200,65) → Sort(332,172) -->
      <path class="rc-arrow-path rc-arr-1"
        d="M 225,82 A 135,135 0 0,1 315,155"
        fill="none" stroke="var(--color-green)" stroke-width="2.5"
        stroke-linecap="round" marker-end="url(#rc-arrow)" />

      <!-- Arrow 2: Sort(332,172) → Process(279,309) -->
      <path class="rc-arrow-path rc-arr-2"
        d="M 333,208 A 135,135 0 0,1 295,285"
        fill="none" stroke="var(--color-green)" stroke-width="2.5"
        stroke-linecap="round" marker-end="url(#rc-arrow)" />

      <!-- Arrow 3: Process(279,309) → Manufacture(121,309) -->
      <path class="rc-arrow-path rc-arr-3"
        d="M 247,325 A 135,135 0 0,1 153,325"
        fill="none" stroke="var(--color-green)" stroke-width="2.5"
        stroke-linecap="round" marker-end="url(#rc-arrow)" />

      <!-- Arrow 4: Manufacture(121,309) → Reuse(72,158) -->
      <path class="rc-arrow-path rc-arr-4"
        d="M 105,285 A 135,135 0 0,1 67,192"
        fill="none" stroke="var(--color-blue)" stroke-width="2.5"
        stroke-linecap="round" marker-end="url(#rc-arrow)" />

      <!-- Arrow 5: Reuse(72,158) → Collect(200,65) -->
      <path class="rc-arrow-path rc-arr-5"
        d="M 85,132 A 135,135 0 0,1 175,70"
        fill="none" stroke="var(--color-blue)" stroke-width="2.5"
        stroke-linecap="round" marker-end="url(#rc-arrow)" />
    </g>

    <!-- ── Centre label ── -->
    <text x="200" y="192" text-anchor="middle" class="rc-center-label">Waste</text>
    <text x="200" y="214" text-anchor="middle" class="rc-center-sub">Lifecycle</text>
  </svg>
</div>

<style>
  /* Scoped design-token refs — no hardcoded hex */
  .rc-wrap {
    --rc-collect:      var(--color-green);
    --rc-sort:         var(--color-blue);
    --rc-process:      var(--color-green-deep);
    --rc-manufacture:  var(--color-blue-deep);
    --rc-reuse:        var(--color-green);

    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .rc-svg {
    width: 100%;
    max-width: 420px;
    height: auto;
    overflow: visible;
  }

  /* ── Rotating dashes ring ── */
  .rc-dash-ring {
    transform-origin: 200px 200px;
    animation: rc-spin 18s linear infinite;
  }

  @keyframes rc-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Node pulse ── */
  .rc-node {
    animation: rc-pulse 3s ease-in-out infinite;
  }
  .rc-node--sort         { animation-delay: 0.6s; }
  .rc-node--process      { animation-delay: 1.2s; }
  .rc-node--manufacture  { animation-delay: 1.8s; }
  .rc-node--reuse        { animation-delay: 2.4s; }

  @keyframes rc-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.82; transform: scale(1.08); }
  }

  /* ── Arrow draw-on animation ── */
  .rc-arrow-path {
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
    animation: rc-draw 1.2s var(--ease-out, cubic-bezier(0.22,1,0.36,1)) forwards;
  }
  .rc-arr-1 { animation-delay: 0.2s; }
  .rc-arr-2 { animation-delay: 0.5s; }
  .rc-arr-3 { animation-delay: 0.8s; }
  .rc-arr-4 { animation-delay: 1.1s; }
  .rc-arr-5 { animation-delay: 1.4s; }

  @keyframes rc-draw {
    to { stroke-dashoffset: 0; }
  }

  /* ── Typography ── */
  .rc-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    fill: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .rc-icon {
    font-size: 22px;
  }

  .rc-center-label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    fill: var(--text);
    letter-spacing: -0.02em;
  }

  .rc-center-sub {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    fill: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Reduced-motion: freeze all animations, show static state ── */
  @media (prefers-reduced-motion: reduce) {
    .rc-dash-ring { animation: none; }
    .rc-node      { animation: none; }
    .rc-arrow-path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
