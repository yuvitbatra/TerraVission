---
// Footer.astro — brand blurb, nav columns, team, project info, copyright
import { SITE, NAV, TEAM, PLACEHOLDERS } from "@/data/site";

const year = new Date().getFullYear();

// Split NAV into two columns for the footer
const navMid = Math.ceil(NAV.length / 2);
const navCol1 = NAV.slice(0, navMid);
const navCol2 = NAV.slice(navMid);
---

<footer id="site-footer" class="site-footer">
  <div class="footer-aura" aria-hidden="true"></div>

  <div class="footer-inner">
    <!-- Row 1: Brand + nav columns + team/project -->
    <div class="footer-grid">

      <!-- Brand blurb -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label={`${SITE.name} — Home`}>
          <svg width="32" height="32" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path
              d="M14 4C14 4 6 9.5 6 16C6 20.418 9.582 24 14 24C18.418 24 22 20.418 22 16C22 9.5 14 4 14 4Z"
              fill="url(#footergrad)"
            />
            <path d="M14 16V24" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.75"/>
            <path d="M14 16C14 16 10 13.5 9 11" stroke="white" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
            <style>
              #footergrad stop:nth-child(1) { stop-color: var(--color-green); }
              #footergrad stop:nth-child(2) { stop-color: var(--color-blue); }
            </style>
            <defs>
              <linearGradient id="footergrad" x1="6" y1="4" x2="22" y2="24" gradientUnits="userSpaceOnUse">
                <stop/>
                <stop offset="1"/>
              </linearGradient>
            </defs>
          </svg>
          <span class="footer-wordmark text-gradient">{SITE.name}</span>
        </a>
        <p class="footer-blurb">{SITE.tagline}</p>
        <p class="footer-desc">
          A student-built sustainability education platform exploring solar, wind,
          rainwater harvesting, waste reduction, and water conservation.
        </p>
      </div>

      <!-- Nav column 1 -->
      <nav class="footer-nav-col" aria-label="Footer navigation — part 1">
        <h3 class="footer-col-heading">Explore</h3>
        <ul role="list">
          {navCol1.map((item) => (
            <li>
              <a href={item.href} class="footer-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Nav column 2 -->
      <nav class="footer-nav-col" aria-label="Footer navigation — part 2">
        <h3 class="footer-col-heading">Learn</h3>
        <ul role="list">
          {navCol2.map((item) => (
            <li>
              <a href={item.href} class="footer-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Team + project info -->
      <div class="footer-meta-col">
        <div class="footer-team">
          <h3 class="footer-col-heading">Team</h3>
          <ul role="list">
            {TEAM.map((member) => (
              <li class="footer-team-member">{member.name}</li>
            ))}
          </ul>
        </div>

        <div class="footer-project">
          <h3 class="footer-col-heading">Project</h3>
          <dl class="project-details">
            <div class="project-row">
              <dt>Class</dt>
              <dd>{PLACEHOLDERS.class}</dd>
            </div>
            <div class="project-row">
              <dt>School</dt>
              <dd>{PLACEHOLDERS.school}</dd>
            </div>
            <div class="project-row">
              <dt>Teacher</dt>
              <dd>{PLACEHOLDERS.teacher}</dd>
            </div>
          </dl>
        </div>
      </div>

    </div>

    <!-- Divider -->
    <div class="footer-divider" role="separator" aria-hidden="true"></div>

    <!-- Row 2: Copyright -->
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {year} {SITE.name}. Built with purpose by student researchers.
      </p>
      <p class="footer-copy footer-copy-muted">
        National Science Exhibition Project &mdash; Sustainability Education
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: 6rem;
    border-top: 1px solid var(--border-hairline);
    background: var(--surface);
    overflow: hidden;
  }

  /* Subtle atmospheric glow behind footer */
  .footer-aura {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(50rem 24rem at 80% 120%, color-mix(in srgb, var(--color-green) 8%, transparent), transparent 70%),
      radial-gradient(40rem 20rem at 10% 110%, color-mix(in srgb, var(--color-blue) 8%, transparent), transparent 70%);
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 2.5rem) clamp(2rem, 4vw, 3rem);
  }

  /* ---- Grid layout ---- */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.4fr;
    }
  }

  /* ---- Brand ---- */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    width: fit-content;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    background-image: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .footer-blurb {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--text);
    margin: 0;
  }

  .footer-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
    max-width: 24rem;
  }

  /* ---- Nav columns ---- */
  .footer-nav-col h3,
  .footer-meta-col h3 {
    /* heading styles below */
  }

  .footer-col-heading {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-subtle);
    margin: 0 0 0.875rem;
  }

  .footer-nav-col ul,
  .footer-team ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-link {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
    display: inline-block;
    padding: 0.1rem 0;
  }

  .footer-link:hover {
    color: var(--color-green);
  }

  /* ---- Team ---- */
  .footer-meta-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-team-member {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-family: var(--font-body);
    padding: 0.1rem 0;
  }

  /* ---- Project placeholders ---- */
  .project-details {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .project-row {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: var(--text-sm);
  }

  .project-row dt {
    color: var(--text-subtle);
    font-weight: 600;
    font-family: var(--font-display);
    white-space: nowrap;
    min-width: 4rem;
  }

  .project-row dd {
    color: var(--text-muted);
    font-style: italic;
  }

  /* ---- Divider ---- */
  .footer-divider {
    height: 1px;
    background: var(--border-hairline);
    margin: 2.5rem 0 1.75rem;
  }

  /* ---- Bottom row ---- */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
  }

  .footer-copy-muted {
    color: var(--text-subtle);
  }
</style>
