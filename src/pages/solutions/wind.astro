---
/**
 * Wind Energy — TerraVision Solutions
 *
 * Covers: what wind energy is; how turbines convert kinetic → rotational →
 * electrical energy; benefits; challenges; future (offshore wind);
 * animated turbine diagram; Wind vs Fossil Fuels comparison.
 *
 * Content is factually accurate and suitable for Class 8–10 learners.
 * All colours via design tokens. Accessible, reduced-motion safe.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import CTAButton from "@/components/ui/CTAButton.astro";
import WindTurbine from "@/components/diagrams/WindTurbine.astro";
---

<BaseLayout
  title="Wind Energy — TerraVision"
  description="Explore how wind turbines convert kinetic energy into clean electricity. Learn the science of wind power, its benefits, real challenges, offshore future, and how it compares to fossil fuels."
>

  <!-- ═══════════════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="wind-hero" aria-labelledby="hero-heading">
    <div class="wind-hero__inner">
      <p class="wind-hero__eyebrow">Clean Energy · Solutions</p>
      <h1 class="wind-hero__title ds-h1" id="hero-heading">
        <span class="text-gradient">Wind Energy</span>
      </h1>
      <p class="wind-hero__sub">
        The kinetic energy of moving air, captured by sweeping rotor blades
        and turned into clean electricity — powering homes without burning
        a single gram of fuel.
      </p>

      <!-- Quick facts strip -->
      <div class="hero-stats" role="list" aria-label="Wind energy quick facts">
        <div class="hero-stat" role="listitem">
          <span class="hero-stat__value">~7.8 %</span>
          <span class="hero-stat__label">of global electricity (2023)</span>
        </div>
        <div class="hero-stat" role="listitem">
          <span class="hero-stat__value">11 g</span>
          <span class="hero-stat__label">CO₂ per kWh (lifecycle)</span>
        </div>
        <div class="hero-stat" role="listitem">
          <span class="hero-stat__value">$0</span>
          <span class="hero-stat__label">fuel cost — wind is free</span>
        </div>
        <div class="hero-stat" role="listitem">
          <span class="hero-stat__value">15 MW</span>
          <span class="hero-stat__label">largest offshore turbine today</span>
        </div>
      </div>

      <div class="hero-actions">
        <CTAButton href="#how-it-works" variant="primary">How It Works</CTAButton>
        <CTAButton href="#comparison" variant="secondary">Wind vs Fossil Fuels</CTAButton>
      </div>
    </div>

    <!-- Decorative floating turbine silhouette in hero background -->
    <div class="hero-turbine-bg" aria-hidden="true">
      <svg viewBox="0 0 200 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero-bg-svg">
        <polygon points="92,318 108,318 104,200 96,200" class="hero-tower" />
        <rect x="82" y="188" width="52" height="20" rx="5" class="hero-nacelle" />
        <g class="hero-blades">
          <path d="M 108,198 C 104,180 102,160 105,135 C 109,160 111,180 108,198 Z" class="hero-blade" />
          <path d="M 108,198 C 104,180 102,160 105,135 C 109,160 111,180 108,198 Z" class="hero-blade" transform="rotate(120 108 198)" />
          <path d="M 108,198 C 104,180 102,160 105,135 C 109,160 111,180 108,198 Z" class="hero-blade" transform="rotate(240 108 198)" />
        </g>
        <circle cx="108" cy="198" r="8" class="hero-hub" />
      </svg>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       WHAT IS WIND ENERGY
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="what-heading">
    <div class="container">
      <SectionHeader
        eyebrow="The Science"
        title="What is Wind Energy?"
        subtitle="Wind energy taps one of Earth's oldest natural forces — flowing air — and converts it into electricity without combustion or emissions."
        align="center"
        id="what-heading"
      />

      <div class="what-grid">
        <GlassCard class="what-card">
          <div class="icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 40 40" class="section-icon"><circle cx="20" cy="20" r="18" class="icon-circle" /><path d="M 12,20 Q 20,12 28,20 Q 20,28 12,20 Z" class="icon-path" /></svg>
          </div>
          <h3 class="card-heading">Why Wind Exists</h3>
          <p>
            Wind is caused by <strong>uneven heating of Earth's surface</strong>
            by the sun. Land heats up faster than water; air over warm surfaces
            rises and cooler air rushes in to replace it — creating wind.
            At larger scales, the Earth's rotation deflects winds (the Coriolis
            effect), giving us the predictable trade winds and jet streams that
            power large wind farms.
          </p>
        </GlassCard>

        <GlassCard class="what-card">
          <div class="icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 40 40" class="section-icon"><circle cx="20" cy="20" r="18" class="icon-circle" /><path d="M 14,26 L 20,14 L 26,26" class="icon-path" fill="none" stroke-width="2" /></svg>
          </div>
          <h3 class="card-heading">Kinetic Energy in Wind</h3>
          <p>
            Moving air carries <strong>kinetic energy</strong> — the energy of
            motion. The power available in wind grows with the <em>cube</em> of
            wind speed: doubling the wind speed gives eight times more power.
            This is why turbines are sited where wind consistently blows at
            7–10 m/s or faster, such as hilltops, coastal areas, and
            offshore locations.
          </p>
        </GlassCard>

        <GlassCard class="what-card">
          <div class="icon-wrap" aria-hidden="true">
            <svg viewBox="0 0 40 40" class="section-icon"><circle cx="20" cy="20" r="18" class="icon-circle" /><text x="20" y="25" text-anchor="middle" class="icon-text">⚡</text></svg>
          </div>
          <h3 class="card-heading">A Global Powerhouse</h3>
          <p>
            Wind turbines first produced electricity in the 1880s, but modern
            commercial wind farms took off in the 1980s. Today, over
            <strong>2 terawatts (2,000 GW)</strong> of wind capacity is installed
            worldwide. Countries like Denmark, Uruguay, and Ireland already
            generate more than 40 % of their electricity from wind alone.
          </p>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       HOW TURBINES WORK
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section section--alt" id="how-it-works" aria-labelledby="how-heading">
    <div class="container">
      <SectionHeader
        eyebrow="Engineering"
        title="How a Wind Turbine Works"
        subtitle="Three energy conversions take wind and turn it into the electricity flowing through your wall socket."
        align="center"
        id="how-heading"
      />

      <!-- Step-by-step energy chain -->
      <ol class="energy-chain" aria-label="Energy conversion steps in a wind turbine">
        <li class="chain-step">
          <div class="step-num" aria-hidden="true">1</div>
          <div class="step-body">
            <h3 class="step-title">Wind Strikes the Blades</h3>
            <p class="step-desc">
              Rotor blades are shaped like <strong>aircraft wings</strong> (aerofoils).
              As wind flows across the curved surface, it travels faster over
              the top than the bottom, creating low pressure above and high
              pressure below. This pressure difference generates <strong>lift</strong>,
              which spins the rotor rather than just pushing it.
            </p>
          </div>
        </li>

        <li class="chain-step">
          <div class="step-num" aria-hidden="true">2</div>
          <div class="step-body">
            <h3 class="step-title">Kinetic → Rotational Energy</h3>
            <p class="step-desc">
              The spinning rotor turns a <strong>main shaft</strong> at typically
              5–20 RPM. A <strong>gearbox</strong> inside the nacelle amplifies
              this to about 1,000–1,800 RPM — the speed a generator needs.
              Newer direct-drive turbines skip the gearbox entirely, using
              permanent-magnet generators that work at low RPM.
            </p>
          </div>
        </li>

        <li class="chain-step">
          <div class="step-num" aria-hidden="true">3</div>
          <div class="step-body">
            <h3 class="step-title">Rotational → Electrical Energy</h3>
            <p class="step-desc">
              The high-speed shaft spins copper coils inside the
              <strong>generator</strong>. Magnets surrounding the coils create a
              changing magnetic field that induces an electric current —
              <em>electromagnetic induction</em>, discovered by Michael Faraday
              in 1831. This produces AC electricity at around 690 V.
            </p>
          </div>
        </li>

        <li class="chain-step">
          <div class="step-num" aria-hidden="true">4</div>
          <div class="step-body">
            <h3 class="step-title">Voltage Stepped Up for Transmission</h3>
            <p class="step-desc">
              A <strong>transformer</strong> at the base of the tower increases
              the voltage to 11–33 kV (or higher for offshore) to reduce
              energy losses during long-distance transmission. The electricity
              then joins the grid and reaches homes and businesses.
            </p>
          </div>
        </li>

        <li class="chain-step">
          <div class="step-num" aria-hidden="true">5</div>
          <div class="step-body">
            <h3 class="step-title">Smart Controls Keep It Safe</h3>
            <p class="step-desc">
              Sensors measure wind speed and direction every second. If winds
              exceed ~25 m/s (90 km/h), automatic <strong>pitch controls</strong>
              rotate the blades edge-on to the wind (feathering) and apply
              disc brakes — preventing mechanical damage and keeping the grid
              supply steady.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       ANIMATED TURBINE DIAGRAM
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section diagram-section" aria-labelledby="diagram-heading">
    <div class="container diagram-container">
      <SectionHeader
        eyebrow="Interactive Diagram"
        title="Turbine Anatomy"
        subtitle="The diagram below labels the key components of a horizontal-axis wind turbine. Watch the blades spin as kinetic energy flows to the generator."
        align="center"
        id="diagram-heading"
      />
      <div class="diagram-card-wrap">
        <GlassCard strong class="diagram-card">
          <WindTurbine />
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       BENEFITS
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="benefits-heading">
    <div class="container">
      <SectionHeader
        eyebrow="Advantages"
        title="Benefits of Wind Energy"
        subtitle="Wind power is one of the lowest-impact, lowest-cost energy sources available at scale."
        align="center"
        id="benefits-heading"
      />

      <div class="benefits-grid">
        <GlassCard class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">🌬️</div>
          <h3>Zero Fuel Cost</h3>
          <p>Wind is free and inexhaustible. Once a turbine is built, the
          "fuel" costs nothing — unlike coal or gas plants that spend billions
          per year importing fuel.</p>
        </GlassCard>

        <GlassCard class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">🌿</div>
          <h3>Near-Zero Emissions</h3>
          <p>Operating turbines release <strong>0 g of CO₂ per kWh</strong>.
          Even counting manufacture and installation, the lifecycle figure is
          just ~11 g/kWh — roughly 75 times less than coal power.</p>
        </GlassCard>

        <GlassCard class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">🌾</div>
          <h3>Small Land Footprint</h3>
          <p>Only the turbine base and access road disturb the land. Crops,
          cattle, and wildlife can coexist within the same field — wind farms
          double as working farmland in many countries.</p>
        </GlassCard>

        <GlassCard class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">📉</div>
          <h3>Falling Costs</h3>
          <p>Onshore wind costs dropped over <strong>70 % since 2010</strong>.
          It is now the cheapest source of new electricity generation in most
          countries — cheaper than new coal or gas even without subsidies.</p>
        </GlassCard>

        <GlassCard class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">💼</div>
          <h3>Job Creation</h3>
          <p>The global wind industry employs over <strong>1.3 million people</strong>
          (IRENA 2023) in manufacturing, installation, operations, and research
          — a number growing faster than fossil fuel employment is declining.</p>
        </GlassCard>

        <GlassCard class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">🔒</div>
          <h3>Energy Independence</h3>
          <p>Wind is a domestic resource. Countries harnessing their own wind
          reduce reliance on imported fuel, improving energy security and
          protecting economies from volatile global commodity prices.</p>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CHALLENGES
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="challenges-heading">
    <div class="container">
      <SectionHeader
        eyebrow="Honest Assessment"
        title="Challenges & Limitations"
        subtitle="No energy source is perfect. Understanding these challenges helps us design better solutions."
        align="center"
        id="challenges-heading"
      />

      <div class="challenges-grid">
        <GlassCard class="challenge-card">
          <div class="challenge-label challenge-label--moderate">Moderate</div>
          <h3>Intermittency</h3>
          <p>
            Wind does not blow constantly. Turbines produce maximum power only
            about <strong>25–45 % of the time</strong> (their "capacity factor").
            This intermittency requires backup generation, battery storage, or
            interconnected grids that can balance supply from different regions.
          </p>
        </GlassCard>

        <GlassCard class="challenge-card">
          <div class="challenge-label challenge-label--moderate">Moderate</div>
          <h3>Siting Requirements</h3>
          <p>
            The best wind resources are often in remote areas — far from the
            cities that need power. Building transmission lines across hundreds
            of kilometres adds cost and requires navigating land rights and
            planning permissions.
          </p>
        </GlassCard>

        <GlassCard class="challenge-card">
          <div class="challenge-label challenge-label--low">Low–Moderate</div>
          <h3>Visual & Noise Impact</h3>
          <p>
            Some communities object to turbines on aesthetic grounds or worry
            about low-frequency noise (typically &lt; 45 dB at 300 m — quieter
            than a conversation). Modern turbines are significantly quieter than
            older designs, and setback regulations address most concerns.
          </p>
        </GlassCard>

        <GlassCard class="challenge-card">
          <div class="challenge-label challenge-label--low">Low</div>
          <h3>Wildlife Interactions</h3>
          <p>
            Turbine blades can injure birds and bats that fly through rotor
            swept areas. Careful site selection (avoiding migration corridors
            and nesting grounds), radar-triggered shutdowns, and UV-painted
            blades dramatically reduce collisions in modern projects.
          </p>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       FUTURE: OFFSHORE WIND
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="offshore-heading">
    <div class="container offshore-container">
      <div class="offshore-text">
        <SectionHeader
          eyebrow="The Future"
          title="Offshore Wind — The Next Frontier"
          subtitle="Moving turbines out to sea unlocks stronger, more consistent winds and avoids onshore land constraints."
          id="offshore-heading"
        />

        <div class="offshore-points">
          <div class="offshore-point">
            <span class="offshore-num">01</span>
            <div>
              <strong>Stronger, Steadier Winds</strong>
              <p>Offshore wind speeds average 20–30 % higher than onshore, and
              winds are more consistent — meaning higher capacity factors (40–60 %)
              and more predictable output.</p>
            </div>
          </div>

          <div class="offshore-point">
            <span class="offshore-num">02</span>
            <div>
              <strong>Floating Foundations</strong>
              <p>Traditional offshore turbines bolt to the seabed, limiting them
              to shallow water. Floating platforms anchored with cables allow
              turbines in water depths over 60 m — unlocking vast new ocean
              areas including off the US west coast and Japan.</p>
            </div>
          </div>

          <div class="offshore-point">
            <span class="offshore-num">03</span>
            <div>
              <strong>Growing Rapidly</strong>
              <p>Global offshore wind capacity exceeded 70 GW in 2023, led by
              China, the UK, and Germany. The International Energy Agency
              projects offshore wind could power <strong>1 billion homes
              worldwide by 2040</strong> under net-zero scenarios.</p>
            </div>
          </div>

          <div class="offshore-point">
            <span class="offshore-num">04</span>
            <div>
              <strong>Colossal Turbines</strong>
              <p>The latest offshore models — like the Vestas V236 — have 15 MW
              capacity and 236-metre rotor diameters (larger than the Eiffel
              Tower is tall). A single rotation at rated wind speed can power
              a home for about 29 hours.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Offshore stats card -->
      <GlassCard strong class="offshore-stats-card">
        <h3 class="offshore-stats-title">Offshore Wind — 2030 Projections</h3>
        <dl class="offshore-dl">
          <div class="offshore-dl-item">
            <dt>Global Capacity</dt>
            <dd><span class="stat-big">380 GW</span></dd>
          </div>
          <div class="offshore-dl-item">
            <dt>Homes Powered</dt>
            <dd><span class="stat-big">80 million+</span></dd>
          </div>
          <div class="offshore-dl-item">
            <dt>Capacity Factor</dt>
            <dd><span class="stat-big">45–60 %</span></dd>
          </div>
          <div class="offshore-dl-item">
            <dt>CO₂ Avoided (annual)</dt>
            <dd><span class="stat-big">~1 Gt</span></dd>
          </div>
        </dl>
        <p class="offshore-source">Sources: IEA World Energy Outlook 2023; GWEC Global Wind Report 2024</p>
      </GlassCard>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       WIND vs FOSSIL FUELS COMPARISON
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section section--alt" id="comparison" aria-labelledby="compare-heading">
    <div class="container">
      <SectionHeader
        eyebrow="Side by Side"
        title="Wind vs Fossil Fuels"
        subtitle="A direct comparison across the metrics that matter most for a sustainable future."
        align="center"
        id="compare-heading"
      />

      <!-- Comparison table — accessible markup -->
      <div class="table-wrap" role="region" aria-label="Wind vs Fossil Fuels comparison table" tabindex="0">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col" class="col-wind">Wind Energy</th>
              <th scope="col" class="col-fossil">Fossil Fuels</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">CO₂ Emissions (lifecycle)</th>
              <td class="col-wind wind-good">~11 g/kWh</td>
              <td class="col-fossil fossil-bad">820 g/kWh (coal)<br/>490 g/kWh (gas)</td>
            </tr>
            <tr>
              <th scope="row">Fuel Cost</th>
              <td class="col-wind wind-good">$0 — wind is free</td>
              <td class="col-fossil fossil-bad">Expensive &amp; price-volatile</td>
            </tr>
            <tr>
              <th scope="row">Water Consumption</th>
              <td class="col-wind wind-good">Negligible</td>
              <td class="col-fossil fossil-bad">High (cooling, processing)</td>
            </tr>
            <tr>
              <th scope="row">Land / Seabed Disturbance</th>
              <td class="col-wind wind-good">Low — shared with farms</td>
              <td class="col-fossil fossil-bad">Significant mining &amp; drilling</td>
            </tr>
            <tr>
              <th scope="row">Energy Security</th>
              <td class="col-wind wind-good">Domestic resource</td>
              <td class="col-fossil fossil-bad">Often import-dependent</td>
            </tr>
            <tr>
              <th scope="row">Jobs (per TWh, IRENA)</th>
              <td class="col-wind wind-good">~340 direct jobs</td>
              <td class="col-fossil fossil-bad">~250 &amp; declining</td>
            </tr>
            <tr>
              <th scope="row">Operational Lifespan</th>
              <td class="col-wind wind-good">25–30 years/turbine</td>
              <td class="col-fossil fossil-neutral">30–50 years (plant)</td>
            </tr>
            <tr>
              <th scope="row">Intermittency</th>
              <td class="col-wind wind-neutral">Variable; needs storage</td>
              <td class="col-fossil fossil-neutral">Dispatchable on demand</td>
            </tr>
            <tr>
              <th scope="row">Levelised Cost (2023)</th>
              <td class="col-wind wind-good">$30–50 / MWh (onshore)</td>
              <td class="col-fossil fossil-bad">$60–100 / MWh (new gas)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Verdict cards -->
      <div class="verdict-grid" aria-label="Summary verdict">
        <GlassCard class="verdict-card verdict-wind">
          <div class="verdict-icon" aria-hidden="true">✅</div>
          <h3>Wind Wins On</h3>
          <ul>
            <li>Climate impact (zero operational emissions)</li>
            <li>Long-run cost (free fuel)</li>
            <li>Water use (near zero)</li>
            <li>Energy independence</li>
            <li>Job quality &amp; growth</li>
          </ul>
        </GlassCard>
        <GlassCard class="verdict-card verdict-challenge">
          <div class="verdict-icon" aria-hidden="true">⚖️</div>
          <h3>Fossil Fuels Still Win On</h3>
          <ul>
            <li>Dispatchability (always-on supply)</li>
            <li>High energy density per cubic metre</li>
            <li>Established grid infrastructure</li>
          </ul>
          <p class="verdict-note">
            Battery storage and smart grids are rapidly closing these gaps.
          </p>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CTA — Explore More Solutions
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="section cta-section" aria-labelledby="cta-heading">
    <div class="container cta-container">
      <GlassCard strong class="cta-card">
        <p class="cta-eyebrow">Keep Exploring</p>
        <h2 class="ds-h2" id="cta-heading">Discover More Clean Solutions</h2>
        <p class="cta-body">
          Wind is one of many tools in the sustainable-energy toolkit.
          Compare it with solar, explore rainwater harvesting, or run
          our energy calculator to see how these technologies can work
          together in your own life.
        </p>
        <div class="cta-actions">
          <CTAButton href="/solutions/solar" variant="primary">Solar Energy</CTAButton>
          <CTAButton href="/solutions/rainwater" variant="secondary">Rainwater Harvesting</CTAButton>
          <CTAButton href="/calculators" variant="ghost">Energy Calculator</CTAButton>
        </div>
      </GlassCard>
    </div>
  </section>

</BaseLayout>

<style>
/* ── Shared layout helpers ──────────────────────────────────────────── */
.container {
  max-width: 72rem;
  margin-inline: auto;
  padding-inline: clamp(1rem, 4vw, 2.5rem);
}

.section {
  padding-block: clamp(4rem, 8vw, 6rem);
}

.section--alt {
  background: color-mix(in srgb, var(--surface-2) 50%, transparent);
}

/* ── HERO ─────────────────────────────────────────────────────────── */
.wind-hero {
  position: relative;
  min-height: clamp(520px, 80svh, 720px);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: clamp(5rem, 10vw, 8rem) clamp(1rem, 4vw, 2.5rem) clamp(4rem, 8vw, 6rem);
}

.wind-hero__inner {
  position: relative;
  z-index: 1;
  max-width: 48rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

.wind-hero__eyebrow {
  font-family: var(--font-display);
  font-size: var(--text-xs);
