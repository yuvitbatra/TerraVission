---
/**
 * Rainwater Harvesting — TerraVision Solutions page
 * Sections: hero definition | working process | collection methods |
 *           storage systems | community benefits | conservation impact |
 *           interactive process diagram
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import CTAButton from "@/components/ui/CTAButton.astro";
import RainwaterProcess from "@/components/diagrams/RainwaterProcess.astro";
import { SITE } from "@/data/site";

const PAGE_TITLE = "Rainwater Harvesting";
const PAGE_DESC =
  "Learn how rainwater harvesting collects, filters, and stores rainwater to replenish groundwater, reduce runoff, and supply clean water to homes and communities — with an interactive animated process diagram.";
---

<BaseLayout title={`${PAGE_TITLE} — ${SITE.name}`} description={PAGE_DESC}>

  <!-- ═══════════════════════════════════════════════════
       HERO — Definition
  ═══════════════════════════════════════════════════ -->
  <section class="rw-hero" aria-labelledby="rw-hero-title">
    <div class="rw-hero-inner">
      <p class="rw-eyebrow">Water Conservation · Solutions</p>
      <h1 class="ds-h1 text-gradient" id="rw-hero-title">Rainwater Harvesting</h1>
      <p class="rw-hero-lead">
        Rainwater harvesting is the systematic collection, storage, and
        utilisation of rainwater that falls on rooftops, land surfaces, and
        paved areas — before it runs off into drains or evaporates. It is one
        of the oldest and most effective techniques for conserving freshwater
        and replenishing underground aquifers.
      </p>
      <p class="rw-hero-sub">
        A single 100 m² roof in a region receiving 800 mm of annual rainfall
        can harvest up to <strong>80,000 litres</strong> of water every year —
        enough for an average family's non-drinking needs.
      </p>
      <div class="rw-hero-stats" role="list">
        <div class="rw-stat glass" role="listitem">
          <span class="rw-stat-num text-gradient">80,000 L</span>
          <span class="rw-stat-label">Per 100 m² roof annually</span>
        </div>
        <div class="rw-stat glass" role="listitem">
          <span class="rw-stat-num text-gradient">40%</span>
          <span class="rw-stat-label">Reduction in runoff possible</span>
        </div>
        <div class="rw-stat glass" role="listitem">
          <span class="rw-stat-num text-gradient">3,000+</span>
          <span class="rw-stat-label">Years of documented use worldwide</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       WORKING PROCESS
  ═══════════════════════════════════════════════════ -->
  <section class="rw-section" aria-labelledby="rw-process-title">
    <div class="rw-container">
      <SectionHeader
        eyebrow="How It Works"
        title="The Rainwater Harvesting Process"
        subtitle="From the moment rain falls to the moment water reaches your tap, six carefully engineered stages ensure cleanliness, efficiency, and sustainability."
        align="center"
        id="rw-process-title"
      />

      <ol class="rw-steps" aria-label="Six steps of rainwater harvesting">
        {[
          {
            step: "01",
            name: "Rainfall Collection",
            detail:
              "Rain falls naturally onto a catchment surface. The catchment area can be a rooftop, paved courtyard, or hillside — any surface that intercepts precipitation and allows it to flow toward a collection system.",
          },
          {
            step: "02",
            name: "Catchment Surface",
            detail:
              "Rooftops are the most common catchment surface. Sloped, smooth roofs (metal, clay tiles, or concrete) maximise water flow and minimise absorption. The area and material directly determine how much water can be collected.",
          },
          {
            step: "03",
            name: "Gutters & Downpipes",
            detail:
              "Gutters along roof edges channel water towards downpipes. Leaf guards prevent blockages. Water flows downward through sealed pipes, reducing contamination and loss due to splashing or evaporation.",
          },
          {
            step: "04",
            name: "First-Flush Diverter & Filter",
            detail:
              "The first flush of rain carries the most pollutants — bird droppings, dust, debris. A first-flush diverter automatically discards this initial volume. Subsequent water passes through a layered filter (gravel → sand → activated charcoal) that removes suspended particles, bacteria, and odours.",
          },
          {
            step: "05",
            name: "Storage Tank",
            detail:
              "Filtered water is stored in above-ground or underground tanks made of ferro-cement, polyethylene, or brick masonry. Tanks must be sealed, dark (to prevent algae), and fitted with overflow pipes and vents to prevent stagnation.",
          },
          {
            step: "06",
            name: "End Use or Groundwater Recharge",
            detail:
              "Stored water can be used directly for gardening, toilet flushing, vehicle washing, and — after further treatment — for drinking. Alternatively, percolation pits and recharge wells allow the water to slowly percolate into the soil and recharge underground aquifers.",
          },
        ].map(({ step, name, detail }) => (
          <li class="rw-step-item glass">
            <span class="rw-step-num text-gradient" aria-hidden="true">{step}</span>
            <div>
              <h3 class="rw-step-name">{name}</h3>
              <p class="rw-step-detail">{detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       INTERACTIVE DIAGRAM
  ═══════════════════════════════════════════════════ -->
  <section class="rw-section rw-section--alt" aria-labelledby="rw-diagram-title">
    <div class="rw-container">
      <SectionHeader
        eyebrow="Process Diagram"
        title="See the System in Action"
        subtitle="The animated diagram below traces water's journey from raindrop to storage tank to recharge well. Each stage is labelled with its function."
        align="center"
        id="rw-diagram-title"
      />
      <GlassCard class="rw-diagram-card">
        <RainwaterProcess />
      </GlassCard>
      <p class="rw-diagram-note">
        <em>Animation pauses automatically when you select "reduce motion" in your device's accessibility settings.</em>
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       COLLECTION METHODS
  ═══════════════════════════════════════════════════ -->
  <section class="rw-section" aria-labelledby="rw-methods-title">
    <div class="rw-container">
      <SectionHeader
        eyebrow="Collection Methods"
        title="Ways to Capture Rainwater"
        subtitle="Different landscapes and needs call for different collection strategies. The two primary approaches are rooftop collection and surface runoff harvesting."
        align="left"
        id="rw-methods-title"
      />

      <div class="rw-methods-grid">
        <!-- Rooftop Collection -->
        <GlassCard class="rw-method-card">
          <div class="rw-method-icon" aria-hidden="true">🏠</div>
          <h3 class="rw-method-title">Rooftop Collection</h3>
          <p class="rw-method-body">
            The most widely used method. Rainwater falling on the roof is
            channelled through gutters and downpipes into a storage tank. It
            requires minimal land, can be retrofitted to existing buildings,
            and is highly effective in urban areas where ground space is
            limited.
          </p>
          <ul class="rw-method-list">
            <li>Ideal for homes, schools, and offices</li>
            <li>Low contamination risk compared to ground runoff</li>
            <li>Easily combined with solar panels on the same roof</li>
            <li>Collection efficiency: 75–90% of total rainfall</li>
          </ul>
        </GlassCard>

        <!-- Surface Runoff Harvesting -->
        <GlassCard class="rw-method-card">
          <div class="rw-method-icon" aria-hidden="true">🌾</div>
          <h3 class="rw-method-title">Surface Runoff Harvesting</h3>
          <p class="rw-method-body">
            Rainwater that flows over agricultural land, roads, or hillsides
            is intercepted and directed into ponds, percolation tanks, or
            check dams. This method is especially important in rural areas
            and for recharging groundwater on a community scale.
          </p>
          <ul class="rw-method-list">
            <li>Check dams and bunds slow runoff and encourage percolation</li>
            <li>Percolation ponds recharge shallow aquifers</li>
            <li>Contour trenches on slopes capture rain before it erodes soil</li>
            <li>Collection efficiency: 40–65% depending on soil type</li>
          </ul>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       STORAGE SYSTEMS
  ═══════════════════════════════════════════════════ -->
  <section class="rw-section rw-section--alt" aria-labelledby="rw-storage-title">
    <div class="rw-container">
      <SectionHeader
        eyebrow="Storage Systems"
        title="Keeping Water Safe & Accessible"
        subtitle="Choosing the right storage system is critical for water quality, longevity, and cost-effectiveness."
        align="left"
        id="rw-storage-title"
      />

      <div class="rw-storage-grid">
        {[
          {
            icon: "🛢️",
            name: "Ferro-Cement Tanks",
            desc: "Built on-site using wire mesh and cement mortar, these tanks are durable (30+ year lifespan), relatively inexpensive, and can be built underground to stay cool. Common capacities: 5,000–50,000 litres.",
          },
          {
            icon: "🔵",
            name: "Polyethylene Tanks",
            desc: "Pre-manufactured, lightweight, and UV-stabilised. Easy to install and available in sizes from 500 to 20,000 litres. Best for above-ground use in households and schools.",
          },
          {
            icon: "🧱",
            name: "Brick Masonry Tanks",
            desc: "Traditional underground cisterns built with plastered brickwork. Suited to communities where cement and bricks are locally available. Naturally cool and can store large volumes (10,000–200,000 litres).",
          },
          {
            icon: "♻️",
            name: "Recharge Pits & Wells",
            desc: "Not a storage system in the conventional sense — recharge pits (1–3 m deep, filled with gravel) allow filtered rainwater to percolate directly into the soil. Used where groundwater replenishment is the primary goal.",
          },
        ].map(({ icon, name, desc }) => (
          <GlassCard class="rw-storage-card">
            <span class="rw-storage-icon" aria-hidden="true">{icon}</span>
            <h3 class="rw-storage-name">{name}</h3>
            <p class="rw-storage-desc">{desc}</p>
          </GlassCard>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       COMMUNITY BENEFITS
  ═══════════════════════════════════════════════════ -->
  <section class="rw-section" aria-labelledby="rw-benefits-title">
    <div class="rw-container">
      <SectionHeader
        eyebrow="Community Benefits"
        title="Why Rainwater Harvesting Matters for Society"
        subtitle="Beyond individual households, rainwater harvesting creates measurable benefits for entire communities and ecosystems."
        align="center"
        id="rw-benefits-title"
      />

      <div class="rw-benefits-grid">
        {[
          {
            icon: "💧",
            title: "Water Security",
            body: "Communities with harvesting infrastructure are more resilient during droughts and intermittent supply. Schools, hospitals, and rural households gain a dependable water source independent of the municipal grid.",
          },
          {
            icon: "💰",
            title: "Cost Savings",
            body: "A properly designed rooftop system can offset 30–50% of a household's water bill. At scale, municipal water treatment and distribution costs fall as demand on centralised systems decreases.",
          },
          {
            icon: "🌱",
            title: "Agricultural Support",
            body: "Farmers use harvested rainwater for irrigation during dry spells, reducing reliance on borewells and protecting crops. This is especially vital in semi-arid regions where monsoon rainfall is the primary water source.",
          },
          {
            icon: "🏙️",
            title: "Urban Flood Mitigation",
            body: "In cities, impervious surfaces cause rain to rush into drains, overwhelming sewers and causing flooding. Decentralised harvesting systems slow this runoff, reducing peak flood flows and urban waterlogging.",
          },
          {
            icon: "📚",
            title: "Education & Awareness",
            body: "Schools that install visible rainwater systems become living laboratories. Students learn about the water cycle, hydrology, and civic responsibility — building the next generation of environmental stewards.",
          },
          {
            icon: "🤝",
            title: "Gender Equity",
            body: "In many rural areas women and girls spend hours each day fetching water. Local rainwater systems dramatically reduce this burden, freeing time for education, economic activity, and community participation.",
          },
        ].map(({ icon, title, body }) => (
          <GlassCard class="rw-benefit-card">
            <span class="rw-benefit-icon" aria-hidden="true">{icon}</span>
            <h3 class="rw-benefit-title">{title}</h3>
            <p class="rw-benefit-body">{body}</p>
          </GlassCard>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CONSERVATION IMPACT
  ═══════════════════════════════════════════════════ -->
  <section class="rw-section rw-section--alt" aria-labelledby="rw-impact-title">
    <div class="rw-container">
      <SectionHeader
        eyebrow="Conservation Impact"
        title="Environmental Impact of Rainwater Harvesting"
        align="center"
        id="rw-impact-title"
      />

      <div class="rw-impact-split">
        <!-- Groundwater Recharge -->
        <GlassCard class="rw-impact-card" strong>
          <h3 class="rw-impact-heading">Groundwater Recharge</h3>
          <p class="rw-impact-body">
            Rainwater harvesting — particularly through recharge pits and
            percolation tanks — directly replenishes underground aquifers. In
            India, excessive groundwater extraction has caused water tables to
            fall by 1–3 metres every decade in several states. Widespread
            adoption of recharge-focused harvesting can stabilise or reverse
            this trend. Studies in Tamil Nadu and Rajasthan show groundwater
            levels rising by 0.5–2 metres within two to three monsoon seasons
            after large-scale recharge programmes are implemented.
          </p>
          <div class="rw-impact-stat">
            <span class="rw-impact-num text-gradient">2 m</span>
            <span class="rw-impact-desc">Average groundwater rise recorded after community recharge programmes (Tamil Nadu, India)</span>
          </div>
        </GlassCard>

        <!-- Reduced Runoff & Erosion -->
        <GlassCard class="rw-impact-card" strong>
          <h3 class="rw-impact-heading">Reduced Runoff & Soil Erosion</h3>
          <p class="rw-impact-body">
            When rain strikes bare soil at high velocity, it dislodges topsoil
            particles — a process called "splash erosion." Rapid runoff then
            carries this sediment into rivers, causing siltation that reduces
            reservoir capacity and harms aquatic life. Rainwater harvesting
            interventions — bunds, check dams, vegetated contour trenches —
            slow runoff velocity, giving water time to infiltrate and
            protecting the topsoil layer. A hectare of protected watershed
            can retain 300–500 additional tonnes of topsoil per year.
          </p>
          <div class="rw-impact-stat">
            <span class="rw-impact-num text-gradient">40%</span>
            <span class="rw-impact-desc">Reduction in storm-water runoff achievable with rooftop harvesting on 30% of urban buildings</span>
          </div>
        </GlassCard>
      </div>

      <!-- Additional impact facts -->
      <ul class="rw-impact-facts">
        {[
          "Harvested rainwater has a lower carbon footprint than pumped, treated, and piped municipal water.",
          "Reduced runoff decreases the load on sewage treatment plants, cutting energy use and chemical costs.",
          "Healthy aquifer recharge sustains springs and perennial rivers that millions of people and ecosystems depend on.",
          "Lower demand on rivers and lakes preserves aquatic habitats and biodiversity.",
          "The Central Ground Water Authority of India mandates rooftop rainwater harvesting for all new constructions in notified areas.",
        ].map((fact) => (
          <li class="rw-impact-fact">
            <span class="rw-fact-bullet" aria-hidden="true">▸</span>
            {fact}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CTA FOOTER
  ═══════════════════════════════════════════════════ -->
  <section class="rw-cta-section" aria-labelledby="rw-cta-title">
    <div class="rw-cta-inner glass">
      <h2 class="rw-cta-title ds-h2 text-gradient" id="rw-cta-title">
        Every Drop Counts
      </h2>
      <p class="rw-cta-body">
        Rainwater harvesting is not a future technology — it is a proven, scalable,
        and affordable solution available right now. Whether at home, at school,
        or in your community, capturing rain is one of the most direct actions
        you can take to conserve water and protect the planet.
      </p>
      <div class="rw-cta-actions">
        <CTAButton href="/solutions" variant="secondary">← All Solutions</CTAButton>
        <CTAButton href="/calculators" variant="primary">Calculate Your Savings</CTAButton>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Section layout utilities ───────────────────── */
  .rw-section {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .rw-section--alt {
    background: color-mix(in srgb, var(--surface-2) 60%, transparent);
  }

  .rw-container {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  /* ── Hero ────────────────────────────────────────── */
  .rw-hero {
    padding-block: clamp(4rem, 10vw, 8rem);
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    text-align: center;
    display: flex;
    justify-content: center;
  }

  .rw-hero-inner {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .rw-eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin: 0;
  }

  .ds-h1 {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0;
  }

  .rw-hero-lead {
    font-size: var(--text-body-lg);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 44rem;
    margin: 0;
    text-wrap: pretty;
  }

  .rw-hero-sub {
    font-size: var(--text-body);
    color: var(--text-subtle);
    line-height: 1.65;
    margin: 0;
    max-width: 40rem;
  }

  .rw-hero-sub strong {
    color: var(--text);
  }

  /* Hero stats row */
  .rw-hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .rw-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1rem 1.5rem;
    min-width: 10rem;
  }

  .rw-stat-num {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .rw-stat-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-align: center;
    max-width: 9rem;
  }

  /* ── Steps list ─────────────────────────────────── */
  .rw-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    counter-reset: step;
  }

  .rw-step-item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem 1.25rem;
    align-items: start;
  }

  .rw-step-num {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    padding-top: 0.15rem;
  }

  .rw-step-name {
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 700;
    margin: 0 0 0.4rem;
    color: var(--text);
  }

  .rw-step-detail {
    font-size: var(--text-body);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.65;
  }

  /* ── Diagram card ─────────────────────────────── */
  .rw-diagram-card {
    padding: clamp(1rem, 3vw, 2rem);
    overflow: hidden;
  }

  .rw-diagram-note {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-subtle);
    margin-top: 1rem;
  }

  /* ── Collection methods ─────────────────────────── */
  .rw-methods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }

  .rw-method-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rw-method-icon {
    font-size: 2.25rem;
    line-height: 1;
  }

  .rw-method-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    margin: 0;
    color: var(--text);
  }

  .rw-method-body {
    font-size: var(--text-body);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.65;
  }

  .rw-method-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .rw-method-list li {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ── Storage systems ────────────────────────────── */
  .rw-storage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .rw-storage-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .rw-storage-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .rw-storage-name {
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 700;
    margin: 0;
    color: var(--text);
  }

  .rw-storage-desc {
    font-size: var(--text-body);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.65;
  }

  /* ── Community benefits ─────────────────────────── */
  .rw-benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .rw-benefit-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .rw-benefit-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .rw-benefit-title {
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 700;
    margin: 0;
    color: var(--text);
  }

  .rw-benefit-body {
    font-size: var(--text-body);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.65;
  }

  /* ── Conservation impact ────────────────────────── */
  .rw-impact-split {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .rw-impact-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rw-impact-heading {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    margin: 0;
    color: var(--text);
  }

  .rw-impact-body {
    font-size: var(--text-body);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .rw-impact-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-hairline);
  }

  .rw-impact-num {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .rw-impact-desc {
    font-size: var(--text-sm);
    color: var(--text-subtle);
    line-height: 1.5;
  }

  /* Impact facts list */
  .rw-impact-facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .rw-impact-fact {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--text-body);
    color: var(--text-muted);
