---
/**
 * Solutions landing — TerraVision
 * Overview of the five sustainability solutions, linking to each detail page.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import TopicCard from "@/components/ui/TopicCard.astro";
import { SITE } from "@/data/site";
import { TOPICS } from "@/data/topics";

const pageTitle = `Solutions — ${SITE.name}`;
const pageDescription =
  "Explore five proven sustainability solutions — solar energy, wind energy, rainwater harvesting, waste management and water purification — and how each one works.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="sol-hero" aria-labelledby="sol-heading">
    <div class="container hero-inner">
      <p class="eyebrow" aria-hidden="true">Real, Proven Technologies</p>
      <h1 id="sol-heading" class="hero-title ds-h1">Eco-Friendly <span class="text-gradient">Solutions</span></h1>
      <p class="hero-subtitle">
        Five practical paths to a cleaner planet. Each one already works today —
        explore how it functions, its benefits, and its real-world impact.
      </p>
    </div>
  </section>

  <section class="page-section" aria-labelledby="sol-grid-heading">
    <div class="container">
      <SectionHeader eyebrow="Choose a Topic" title="Explore Each Solution" align="center" />
      <div class="sol-grid" role="list">
        {
          TOPICS.map((t) => (
            <TopicCard
              title={t.title}
              blurb={t.blurb}
              href={t.href}
              accent={t.accent}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 72rem; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 2.5rem); }
  .page-section { padding-block: clamp(2.5rem, 7vw, 4.5rem); }
  .sol-hero { padding: clamp(4rem, 10vw, 6.5rem) 0 clamp(1.5rem, 4vw, 2.5rem); text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .eyebrow { font-family: var(--font-display); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-green); margin: 0; }
  .hero-title { font-family: var(--font-display); font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; margin: 0; }
  .hero-subtitle { font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.7; max-width: 42rem; margin: 0; }
  .sol-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1.25rem; }
</style>
