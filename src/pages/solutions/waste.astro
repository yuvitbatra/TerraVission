---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import CTAButton from "@/components/ui/CTAButton.astro";
import RecyclingCycle from "@/components/diagrams/RecyclingCycle.astro";
---

<BaseLayout
  title="Waste Management — TerraVision"
  description="Learn how to reduce, reuse, and recycle waste through composting, segregation, and smart waste systems. An interactive guide for Class 8–10 students."
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="wm-hero">
    <div class="wm-hero-inner">
      <p class="wm-eyebrow">Solutions · Waste Management</p>
      <h1 class="wm-hero-title">
        Rethink <span class="text-gradient">Waste</span>
      </h1>
      <p class="wm-hero-desc">
        Every year, the world generates over <strong>2.01 billion tonnes</strong> of municipal solid waste.
        But waste is not a dead-end — it's a misplaced resource. Discover how smart choices at home and
        school can close the loop.
      </p>
      <div class="wm-hero-actions">
        <CTAButton href="#segregation" variant="primary">Segregation Guide</CTAButton>
        <CTAButton href="#3rs" variant="ghost">The 3 R's</CTAButton>
      </div>
    </div>
    <div class="wm-hero-badge glass" aria-hidden="true">
      <span class="wm-badge-icon">♻️</span>
      <span class="wm-badge-stat">2 billion+</span>
      <span class="wm-badge-label">tonnes of waste per year globally</span>
    </div>
  </section>

  <!-- ── Types of Waste ────────────────────────────────────── -->
  <section class="wm-section" id="types">
    <div class="wm-container">
      <SectionHeader
        eyebrow="Classification"
        title="Types of Waste"
        subtitle="Understanding what we throw away is the first step to managing it better. Waste falls into four main categories."
        align="center"
      />

      <div class="wm-types-grid">
        <!-- Organic / Wet -->
        <GlassCard class="wm-type-card wm-type--organic">
          <div class="wm-type-icon-wrap" style="--type-color: var(--wm-organic);">
            <span class="wm-type-icon">🌿</span>
          </div>
          <h3 class="wm-type-name">Organic / Wet Waste</h3>
          <p class="wm-type-desc">
            Food scraps, vegetable peels, fruit waste, cooked food, garden cuttings, and
            biodegradable materials. Roughly <strong>50–60%</strong> of household waste in India
            is organic.
          </p>
          <ul class="wm-type-list">
            <li>Decomposes naturally in days to weeks</li>
            <li>Can be composted into rich garden fertiliser</li>
            <li>Produces methane in landfills if not segregated</li>
          </ul>
          <div class="wm-type-bin" style="--type-color: var(--wm-organic);">
            <span class="wm-bin-dot"></span> Green Bin
          </div>
        </GlassCard>

        <!-- Dry / Recyclable -->
        <GlassCard class="wm-type-card wm-type--dry">
          <div class="wm-type-icon-wrap" style="--type-color: var(--wm-dry);">
            <span class="wm-type-icon">📦</span>
          </div>
          <h3 class="wm-type-name">Dry / Recyclable Waste</h3>
          <p class="wm-type-desc">
            Paper, cardboard, glass, metals (cans, foil), and clean plastic packaging.
            These materials can be collected, sorted, and sent to recycling facilities.
          </p>
          <ul class="wm-type-list">
            <li>Paper can be recycled up to 7 times</li>
            <li>Aluminium recycling saves 95% of the energy vs. new production</li>
            <li>Must be dry and clean — rinsed containers recycle better</li>
          </ul>
          <div class="wm-type-bin" style="--type-color: var(--wm-dry);">
            <span class="wm-bin-dot"></span> Blue Bin
          </div>
        </GlassCard>

        <!-- Hazardous -->
        <GlassCard class="wm-type-card wm-type--hazardous">
          <div class="wm-type-icon-wrap" style="--type-color: var(--wm-hazardous);">
            <span class="wm-type-icon">⚠️</span>
          </div>
          <h3 class="wm-type-name">Hazardous Waste</h3>
          <p class="wm-type-desc">
            Batteries, paints, solvents, pesticides, medicines, fluorescent bulbs, and
            cleaning chemicals. These contain toxins that can leach into soil and water.
          </p>
          <ul class="wm-type-list">
            <li>Never mix with regular household waste</li>
            <li>Drop at authorised collection points or pharmacies</li>
            <li>Improper disposal can contaminate groundwater for decades</li>
          </ul>
          <div class="wm-type-bin" style="--type-color: var(--wm-hazardous);">
            <span class="wm-bin-dot"></span> Red Bin
          </div>
        </GlassCard>

        <!-- E-Waste -->
        <GlassCard class="wm-type-card wm-type--ewaste">
          <div class="wm-type-icon-wrap" style="--type-color: var(--wm-ewaste);">
            <span class="wm-type-icon">💻</span>
          </div>
          <h3 class="wm-type-name">E-Waste</h3>
          <p class="wm-type-desc">
            Old phones, laptops, televisions, chargers, and electronic appliances. India is
            the third-largest generator of e-waste globally, producing over <strong>3.2 million
            tonnes</strong> per year.
          </p>
          <ul class="wm-type-list">
            <li>Contains gold, silver, copper — valuable if recovered properly</li>
            <li>Also contains lead, mercury, cadmium — toxic if burnt informally</li>
            <li>Return to certified e-waste recyclers or brand take-back programmes</li>
          </ul>
          <div class="wm-type-bin" style="--type-color: var(--wm-ewaste);">
            <span class="wm-bin-dot"></span> Authorised E-Waste Centre
          </div>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ── 3 R's Hierarchy ───────────────────────────────────── -->
  <section class="wm-section wm-section--alt" id="3rs">
    <div class="wm-container">
      <SectionHeader
        eyebrow="Waste Hierarchy"
        title="Reduce · Reuse · Recycle"
        subtitle="The 3 R's are arranged as a hierarchy — Reduce is the most powerful action, Recycle the last resort. Acting at the top of the pyramid prevents waste from ever being created."
        align="center"
      />

      <div class="wm-pyramid">
        <div class="wm-pyramid-row wm-pyr--reduce">
          <GlassCard strong class="wm-pyr-card">
            <div class="wm-pyr-header">
              <span class="wm-pyr-rank">1</span>
              <h3 class="wm-pyr-title">♻ Reduce</h3>
              <span class="wm-pyr-badge">Most Effective</span>
            </div>
            <p class="wm-pyr-desc">
              Buy only what you need. Choose products with minimal packaging. Opt for
              digital receipts. Bring reusable bags. Refuse single-use plastics.
              Reducing at source means less energy, fewer resources, and zero disposal cost.
            </p>
            <div class="wm-pyr-examples">
              <span>Cloth bags</span><span>Bulk buying</span><span>Digital docs</span><span>Minimal packaging</span>
            </div>
          </GlassCard>
        </div>

        <div class="wm-pyramid-row wm-pyr--reuse">
          <GlassCard class="wm-pyr-card">
            <div class="wm-pyr-header">
              <span class="wm-pyr-rank">2</span>
              <h3 class="wm-pyr-title">🔄 Reuse</h3>
              <span class="wm-pyr-badge">High Impact</span>
            </div>
            <p class="wm-pyr-desc">
              Give items a second life before discarding them. Donate clothes, repair
              electronics, refill water bottles, repurpose glass jars as storage, and use
              both sides of paper. Reuse extends product life and keeps materials in
              circulation without additional energy.
            </p>
            <div class="wm-pyr-examples">
              <span>Repair & donate</span><span>Refillable bottles</span><span>Repurpose containers</span>
            </div>
          </GlassCard>
        </div>

        <div class="wm-pyramid-row wm-pyr--recycle">
          <GlassCard class="wm-pyr-card">
            <div class="wm-pyr-header">
              <span class="wm-pyr-rank">3</span>
              <h3 class="wm-pyr-title">♼ Recycle</h3>
              <span class="wm-pyr-badge">Still Valuable</span>
            </div>
            <p class="wm-pyr-desc">
              When reduction and reuse aren't possible, recycling converts waste into raw
              materials for new products. Proper segregation is key — contaminated recyclables
              go to landfill. Clean paper, metals, glass, and rigid plastics (PET, HDPE) are
              most recyclable.
            </p>
            <div class="wm-pyr-examples">
              <span>Clean paper</span><span>Metal cans</span><span>Glass bottles</span><span>PET plastic</span>
            </div>
          </GlassCard>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Recycling Cycle Diagram ───────────────────────────── -->
  <section class="wm-section" id="cycle">
    <div class="wm-container">
      <SectionHeader
        eyebrow="How It Works"
        title="The Recycling Lifecycle"
        subtitle="Recycled materials travel through a five-stage loop before becoming new products. Each stage adds value and keeps resources out of landfills."
        align="center"
      />

      <div class="wm-cycle-layout">
        <div class="wm-cycle-diagram glass">
          <RecyclingCycle />
        </div>

        <div class="wm-cycle-steps">
          {[
            { step: "01", icon: "🗑️", name: "Collect", desc: "Waste is collected from homes, schools, and businesses through door-to-door collection or drop-off centres, ideally already segregated at source." },
            { step: "02", icon: "♻️", name: "Sort", desc: "At material recovery facilities (MRFs), waste is sorted by type — paper, glass, plastics, metals — manually and with magnetic/optical sensors." },
            { step: "03", icon: "⚙️", name: "Process", desc: "Sorted materials are cleaned, shredded, melted, or pulped to break them down into secondary raw materials ready for manufacturing." },
            { step: "04", icon: "🏭", name: "Manufacture", desc: "Secondary raw materials are used to make new products — recycled PET becomes polyester fibre; old newspapers become egg boxes; scrap metal becomes rebar." },
            { step: "05", icon: "🔄", name: "Reuse", desc: "New products reach consumers, completing the loop. The cycle restarts when those products are eventually discarded and properly segregated again." },
          ].map(({ step, icon, name, desc }) => (
            <div class="wm-cycle-step">
              <div class="wm-cs-num">{step}</div>
              <div class="wm-cs-body">
                <h4 class="wm-cs-title">{icon} {name}</h4>
                <p class="wm-cs-desc">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Composting ────────────────────────────────────────── -->
  <section class="wm-section wm-section--alt" id="composting">
    <div class="wm-container">
      <SectionHeader
        eyebrow="Organic Waste Solution"
        title="Composting at Home"
        subtitle="Composting turns kitchen and garden waste into nutrient-rich soil amendment — diverting up to 30% of household waste from landfill."
        align="left"
      />

      <div class="wm-compost-grid">
        <GlassCard class="wm-compost-main">
          <h3 class="wm-sub-h">How Composting Works</h3>
          <p>
            Micro-organisms (bacteria, fungi) and macro-organisms (worms) break down organic
            matter in the presence of air, moisture, and the right carbon-to-nitrogen ratio.
            The result is humus — dark, crumbly material that improves soil structure,
            water retention, and plant nutrition.
          </p>
          <h4 class="wm-sub-h4 mt-4">What to Compost</h4>
          <div class="wm-compost-cols">
            <div class="wm-compost-yes">
              <p class="wm-compost-head wm-compost-head--yes">✅ Add These (Greens &amp; Browns)</p>
              <ul>
                <li>Vegetable and fruit peels</li>
                <li>Tea bags and coffee grounds</li>
                <li>Eggshells (ground up)</li>
                <li>Dry leaves, straw, cardboard pieces</li>
                <li>Garden trimmings</li>
                <li>Newspaper (shredded)</li>
              </ul>
            </div>
            <div class="wm-compost-no">
              <p class="wm-compost-head wm-compost-head--no">❌ Avoid These</p>
              <ul>
                <li>Meat, fish, dairy products</li>
                <li>Oily or greasy food</li>
                <li>Diseased plants</li>
                <li>Pet waste</li>
                <li>Glossy paper or plastics</li>
              </ul>
            </div>
          </div>
        </GlassCard>

        <div class="wm-compost-tips">
          <GlassCard class="wm-tip-card">
            <span class="wm-tip-icon">💧</span>
            <h4>Keep It Moist</h4>
            <p>The compost pile should feel like a wrung-out sponge — damp but not soggy. Add water if it dries out; add dry leaves if it gets too wet.</p>
          </GlassCard>
          <GlassCard class="wm-tip-card">
            <span class="wm-tip-icon">🌬️</span>
            <h4>Turn Regularly</h4>
            <p>Aerate your pile by turning it every 1–2 weeks. Oxygen is essential for aerobic decomposition and prevents foul odours.</p>
          </GlassCard>
          <GlassCard class="wm-tip-card">
            <span class="wm-tip-icon">⚖️</span>
            <h4>Balance Greens &amp; Browns</h4>
            <p>Aim for roughly 1 part nitrogen-rich "greens" (food scraps) to 2–3 parts carbon-rich "browns" (dry leaves, cardboard). This optimises microbial activity.</p>
          </GlassCard>
          <GlassCard class="wm-tip-card">
            <span class="wm-tip-icon">🪱</span>
            <h4>Try Vermicomposting</h4>
            <p>Add red wriggler worms to speed decomposition dramatically. Worm castings (vermicompost) are 5× richer in nutrients than ordinary compost.</p>
          </GlassCard>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Plastic Reduction ─────────────────────────────────── -->
  <section class="wm-section" id="plastic">
    <div class="wm-container">
      <SectionHeader
        eyebrow="Plastic Pollution"
        title="Cutting Plastic Waste"
        subtitle="Only 9% of all plastic ever produced has been recycled. The rest ends up in landfills, waterways, or the environment — including the ocean."
        align="center"
      />

      <div class="wm-plastic-grid">
        <GlassCard strong class="wm-plastic-stat">
          <span class="wm-big-num text-gradient">9%</span>
          <p>of all plastic ever produced has been recycled</p>
        </GlassCard>
        <GlassCard strong class="wm-plastic-stat">
          <span class="wm-big-num text-gradient">12%</span>
          <p>has been incinerated (releasing toxic gases)</p>
        </GlassCard>
        <GlassCard strong class="wm-plastic-stat">
          <span class="wm-big-num text-gradient">79%</span>
          <p>has accumulated in landfills or the environment</p>
        </GlassCard>

        <GlassCard class="wm-plastic-actions">
          <h3 class="wm-sub-h">Practical Plastic Swaps</h3>
          <ul class="wm-swap-list">
            <li><span class="wm-swap-x">❌ Plastic bags</span> → <span class="wm-swap-y">Cloth / jute tote bags</span></li>
            <li><span class="wm-swap-x">❌ Plastic bottles</span> → <span class="wm-swap-y">Stainless steel / glass bottle</span></li>
            <li><span class="wm-swap-x">❌ Plastic straws</span> → <span class="wm-swap-y">Bamboo / steel / paper straws</span></li>
            <li><span class="wm-swap-x">❌ Cling wrap</span> → <span class="wm-swap-y">Beeswax wraps or reusable lids</span></li>
            <li><span class="wm-swap-x">❌ Plastic cutlery</span> → <span class="wm-swap-y">Bamboo / metal cutlery sets</span></li>
            <li><span class="wm-swap-x">❌ Microwave plastic containers</span> → <span class="wm-swap-y">Glass or ceramic containers</span></li>
            <li><span class="wm-swap-x">❌ Plastic toothbrush</span> → <span class="wm-swap-y">Bamboo toothbrush</span></li>
          </ul>
        </GlassCard>

        <GlassCard class="wm-plastic-know">
          <h3 class="wm-sub-h">Know Your Plastic Codes</h3>
          <p class="wm-sub-note">The resin identification code (number in triangle) tells you how recyclable a plastic is.</p>
          <div class="wm-resin-list">
            {[
              { code: "1", name: "PET", recycle: true, ex: "Water bottles, food jars" },
              { code: "2", name: "HDPE", recycle: true, ex: "Milk jugs, shampoo bottles" },
              { code: "3", name: "PVC", recycle: false, ex: "Pipes, flooring — toxic if burned" },
              { code: "4", name: "LDPE", recycle: true, ex: "Bread bags, squeezable bottles" },
              { code: "5", name: "PP", recycle: true, ex: "Yoghurt tubs, bottle caps" },
              { code: "6", name: "PS", recycle: false, ex: "Styrofoam — difficult to recycle" },
              { code: "7", name: "Other", recycle: false, ex: "Mixed — check locally" },
            ].map(({ code, name, recycle, ex }) => (
              <div class:list={["wm-resin-row", recycle ? "wm-resin--ok" : "wm-resin--no"]}>
                <span class="wm-resin-code">▲{code}</span>
                <span class="wm-resin-name">{name}</span>
                <span class="wm-resin-status">{recycle ? "✅ Recyclable" : "⛔ Avoid"}</span>
                <span class="wm-resin-ex">{ex}</span>
              </div>
            ))}
          </div>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ── Smart Waste Systems ───────────────────────────────── -->
  <section class="wm-section wm-section--alt" id="smart">
    <div class="wm-container">
      <SectionHeader
        eyebrow="Technology &amp; Innovation"
        title="Smart Waste Systems"
        subtitle="Cities are deploying technology to make waste collection more efficient, reduce overflow, and improve recycling rates."
        align="center"
      />

      <div class="wm-smart-grid">
        {[
          {
            icon: "📡",
            title: "IoT Fill-Level Sensors",
            desc: "Ultrasonic sensors inside bins transmit fill levels in real time. Collection trucks are dispatched only when bins are nearly full, cutting fuel use by up to 40% and reducing unnecessary truck runs.",
          },
          {
            icon: "🤖",
            title: "AI Sorting Robots",
            desc: "Computer-vision robotic arms at sorting facilities identify and pick recyclables at 60–80 items per minute — 5× faster than manual sorting — with >95% accuracy for metals, paper, and PET plastic.",
          },
          {
            icon: "📱",
            title: "Citizen Reporting Apps",
            desc: "Mobile apps (e.g., Swachh Bharat app, local municipality portals) let residents report overflowing bins, illegal dumping, and missed collections, enabling rapid municipal response.",
          },
          {
            icon: "⚡",
            title: "Waste-to-Energy Plants",
            desc: "Large volumes of non-recyclable waste are combusted in controlled, scrubbed incinerators to generate electricity. One tonne of waste yields roughly 500–600 kWh of power — but this is a last resort, after reduce/reuse/recycle.",
          },
          {
            icon: "🧪",
            title: "Chemical Recycling",
            desc: "Pyrolysis and solvolysis break complex mixed plastics back into oils and monomers that conventional mechanical recycling cannot handle, expanding what can be recovered from the waste stream.",
          },
          {
            icon: "📊",
            title: "Waste Audit Analytics",
            desc: "Weighing bins at source and analysing material composition gives schools, offices, and cities precise data on their waste profile — enabling targeted campaigns that cut disposal costs measurably.",
          },
        ].map(({ icon, title, desc }) => (
          <GlassCard class="wm-smart-card">
            <span class="wm-smart-icon">{icon}</span>
            <h3 class="wm-smart-title">{title}</h3>
            <p class="wm-smart-desc">{desc}</p>
          </GlassCard>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Segregation Guide ─────────────────────────────────── -->
  <section class="wm-section" id="segregation">
    <div class="wm-container">
      <SectionHeader
        eyebrow="Quick Reference"
        title="Bin Segregation Guide"
        subtitle="Correct segregation at source is the single highest-leverage action you can take. Use this reference to sort common items correctly."
        align="center"
      />

      <div class="wm-seg-bins">
        <!-- Green bin -->
        <GlassCard class="wm-seg-bin wm-seg--green">
          <div class="wm-seg-bin-header" style="--seg-color: var(--wm-seg-green);">
            <span class="wm-seg-bin-icon">🟢</span>
            <h3>Green Bin</h3>
            <p class="wm-seg-bin-type">Wet / Organic</p>
          </div>
          <ul class="wm-seg-items">
            <li>Vegetable &amp; fruit peels</li>
            <li>Leftover cooked food</li>
            <li>Tea leaves &amp; coffee grounds</li>
            <li>Eggshells</li>
            <li>Flower petals &amp; leaves</li>
            <li>Biodegradable paper napkins</li>
            <li>Grass clippings</li>
          </ul>
        </GlassCard>

        <!-- Blue bin -->
        <GlassCard class="wm-seg-bin wm-seg--blue">
          <div class="wm-seg-bin-header" style="--seg-color: var(--wm-seg-blue);">
            <span class="wm-seg-bin-icon">🔵</span>
            <h3>Blue Bin</h3>
            <p class="wm-seg-bin-type">Dry / Recyclable</p>
          </div>
          <ul class="wm-seg-items">
            <li>Clean paper &amp; cardboard</li>
            <li>Glass bottles &amp; jars (rinsed)</li>
            <li>Metal cans &amp; foil (rinsed)</li>
            <li>Rigid plastic (PET, HDPE, PP)</li>
            <li>Tetra Pak cartons (rinsed)</li>
            <li>Magazines &amp; newspapers</li>
            <li>Plastic bags (clean)</li>
          </ul>
        </GlassCard>

        <!-- Red / hazardous bin -->
        <GlassCard class="wm-seg-bin wm-seg--red">
          <div class="wm-seg-bin-header" style="--seg-color: var(--wm-seg-red);">
            <span class="wm-seg-bin-icon">🔴</span>
            <h3>Red Bin</h3>
            <p class="wm-seg-bin-type">Hazardous Waste</p>
          </div>
          <ul class="wm-seg-items">
            <li>Batteries (all types)</li>
            <li>Paint tins &amp; solvents</li>
            <li>Pesticides &amp; herbicides</li>
            <li>Expired medicines</li>
            <li>Fluorescent &amp; CFL bulbs</li>
            <li>Motor oil &amp; fuel containers</li>
            <li>Cleaning chemicals</li>
          </ul>
        </GlassCard>

        <!-- E-waste -->
        <GlassCard class="wm-seg-bin wm-seg--ewaste">
          <div class="wm-seg-bin-header" style="--seg-color: var(--wm-seg-ewaste);">
            <span class="wm-seg-bin-icon">🟣</span>
            <h3>E-Waste Centre</h3>
            <p class="wm-seg-bin-type">Electronic Waste</p>
          </div>
          <ul class="wm-seg-items">
            <li>Mobile phones &amp; chargers</li>
            <li>Laptops &amp; tablets</li>
            <li>TVs &amp; monitors</li>
            <li>Keyboards &amp; mice</li>
            <li>Printers &amp; scanners</li>
            <li>Cables &amp; adaptors</li>
            <li>Refrigerators &amp; ACs</li>
          </ul>
        </GlassCard>
      </div>

      <!-- Quick don't-mix callout -->
      <GlassCard strong class="wm-seg-callout">
        <span class="wm-callout-icon">⚡</span>
        <div>
          <h4 class="wm-callout-title">The #1 Rule: Don't Mix Wet with Dry</h4>
          <p class="wm-callout-body">
            A single food-contaminated item in a recycling bin can make the entire batch unrecyclable.
            Always rinse containers, shake out liquid, and keep wet and dry waste in separate bags
            before placing them in the correct bin. This one habit can double your household's
            recycling rate.
          </p>
        </div>
      </GlassCard>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────── -->
  <section class="wm-section wm-section--cta">
    <div class="wm-container wm-cta-inner">
      <h2 class="wm-cta-title">Ready to Close the Loop?</h2>
      <p class="wm-cta-sub">
        Start with one change this week — a compost bin, a reusable bottle, or a bin audit at school.
        Small, consistent habits compound into large, measurable impact.
      </p>
      <div class="wm-cta-btns">
        <CTAButton href="/calculators" variant="primary" size="lg">Calculate Your Waste Impact</CTAButton>
        <CTAButton href="/tips" variant="ghost" size="lg">Daily Eco-Tips</CTAButton>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Page-scoped category colour vars (token-derived, not raw hex) ── */
  :root, [data-theme="dark"] {
    --wm-organic:    var(--color-green);
