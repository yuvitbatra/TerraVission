---
/**
 * About + SDGs — TerraVision
 *
 * Covers: what sustainability is; why conservation matters; current global
 * challenges; SDG overview grid (GlassCards); animated StatCounter cards with
 * accurate, citable figures.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import StatCounter from "@/components/ui/StatCounter.astro";
import CTAButton from "@/components/ui/CTAButton.astro";
import { SITE } from "@/data/site";
import { SDGS } from "@/data/sdgs";

const pageTitle = `About — ${SITE.name}`;
const pageDescription =
  "Learn what sustainability means, why conservation matters, the urgent global challenges we face, and how the UN Sustainable Development Goals chart a path forward.";

const challenges = [
  {
    icon: "🌡️",
    label: "Climate Change",
    body: "Rising greenhouse gas concentrations are pushing global temperatures toward thresholds that trigger irreversible tipping points — from ice-sheet collapse to widespread coral bleaching.",
  },
  {
    icon: "🏭",
    label: "Pollution",
    body: "Air pollution causes 7 million premature deaths annually (WHO). Plastic waste contaminates every ocean on Earth, and toxic runoff from agriculture and industry degrades rivers and soils worldwide.",
  },
  {
    icon: "⛏️",
    label: "Resource Depletion",
    body: "We extract over 100 billion tonnes of materials from the planet each year. At current rates, freshwater aquifers, old-growth forests, and critical minerals will be exhausted within generations.",
  },
  {
    icon: "🦋",
    label: "Biodiversity Loss",
    body: "The planet is in the midst of its sixth mass-extinction event, driven by habitat destruction, invasive species, overexploitation, and climate change — threatening the ecosystems all life depends on.",
  },
];

/**
 * Stat sources (cited in aria-labels and visible footnotes):
 *  • Temp rise: IPCC Sixth Assessment Report (AR6), 2021/2023 — ~1.1–1.2 °C
 *  • Clean water: WHO/UNICEF JMP 2023 — 2.2 billion lack safely managed drinking water
 *  • Renewables: IEA Electricity 2024 — ~30 % of global electricity
 *  • Species at risk: IPBES Global Assessment 2019 — ~1 million species threatened
 */
const stats = [
  {
    value: 1.2,
    decimals: 1,
    suffix: "°C",
    label: "Global warming above pre-industrial levels",
    note: "IPCC AR6, 2023",
  },
  {
    value: 2.2,
    decimals: 1,
    suffix: "B",
    label: "People lacking safely managed drinking water",
    note: "WHO/UNICEF JMP, 2023",
  },
  {
    value: 30,
    suffix: "%",
    label: "Share of global electricity from renewables",
    note: "IEA, 2024",
  },
  {
    value: 1,
    suffix: "M+",
    label: "Species at risk of extinction",
    note: "IPBES, 2019",
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- ====================================================
       HERO
       ==================================================== -->
  <section class="about-hero" aria-labelledby="about-hero-heading">
    <div class="about-hero-inner">
      <p class="about-eyebrow" aria-hidden="true">About TerraVision</p>
      <h1 id="about-hero-heading" class="about-hero-title ds-h1">
        <span class="text-gradient">Sustainability</span> &amp; Why It Matters
      </h1>
      <p class="about-hero-subtitle">
        Our planet is at a crossroads. Understanding the challenges — and the
        global frameworks built to address them — is the first step towards
        meaningful action.
      </p>
    </div>
  </section>

  <!-- ====================================================
       WHAT IS SUSTAINABILITY?
       ==================================================== -->
  <section class="page-section" aria-labelledby="what-is-heading">
    <div class="container">
      <div class="two-col-layout">
        <div class="two-col-text">
          <SectionHeader
            eyebrow="The Foundation"
            title="What Is Sustainability?"
          />
          <div class="prose-content">
            <p>
              Sustainability is the capacity to meet the needs of the present
              without compromising the ability of future generations to meet
              their own needs — a definition coined in the landmark 1987 UN
              Brundtland Report. It rests on three interlocking pillars:
            </p>
            <ul class="pillars-list" role="list">
              <li>
                <strong class="pillar-name pillar-env">Environmental</strong> —
                protecting natural systems, biodiversity, and the climate
                stability that all life depends upon.
              </li>
              <li>
                <strong class="pillar-name pillar-soc">Social</strong> —
                ensuring equity, health, education, and human rights so every
                person can thrive.
              </li>
              <li>
                <strong class="pillar-name pillar-eco">Economic</strong> —
                building prosperity that operates within planetary boundaries,
                rather than at their expense.
              </li>
            </ul>
            <p>
              True sustainability requires all three pillars to reinforce each
              other. Environmental degradation drives poverty; poverty prevents
              communities from protecting nature. Breaking this cycle demands
              systemic thinking — and systemic action.
            </p>
          </div>
        </div>
        <GlassCard class="what-card" strong>
          <blockquote class="pull-quote">
            <p>
              "Sustainable development is development that meets the needs of
              the present without compromising the ability of future generations
              to meet their own needs."
            </p>
            <footer>
              <cite>— Brundtland Report, Our Common Future (1987)</cite>
            </footer>
          </blockquote>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ====================================================
       WHY CONSERVATION MATTERS
       ==================================================== -->
  <section class="page-section page-section--alt" aria-labelledby="why-heading">
    <div class="container">
      <SectionHeader
        eyebrow="Conservation"
        title="Why Protecting Nature Matters"
        subtitle="Nature is not merely scenery — it is the infrastructure underpinning every economy and every human life."
        align="center"
      />
      <div class="conservation-grid" role="list">
        <GlassCard class="cons-card" role="listitem">
          <div class="cons-icon" aria-hidden="true">💧</div>
          <h3 class="cons-title">Ecosystem Services</h3>
          <p>
            Healthy ecosystems purify air and water, pollinate crops, regulate
            climate, and cycle nutrients. The global value of these "free"
            services is estimated at over $125 trillion per year — yet they are
            treated as externalities in most economies.
          </p>
        </GlassCard>
        <GlassCard class="cons-card" role="listitem">
          <div class="cons-icon" aria-hidden="true">🌱</div>
          <h3 class="cons-title">Food &amp; Water Security</h3>
          <p>
            Three-quarters of food crops depend on pollinators. Forests and
            wetlands regulate rainfall and recharge groundwater. Degrade these
            systems and the agricultural foundation feeding 8 billion people
            begins to crack.
          </p>
        </GlassCard>
        <GlassCard class="cons-card" role="listitem">
          <div class="cons-icon" aria-hidden="true">🧬</div>
          <h3 class="cons-title">Medicine &amp; Innovation</h3>
          <p>
            Over half of modern medicines originate from natural compounds.
            Biodiversity is a library of biological solutions refined over
            billions of years — one we are erasing faster than we can read it.
          </p>
        </GlassCard>
        <GlassCard class="cons-card" role="listitem">
          <div class="cons-icon" aria-hidden="true">🌊</div>
          <h3 class="cons-title">Climate Regulation</h3>
          <p>
            Forests, soils, and oceans together absorb roughly half of all
            human CO₂ emissions each year. Intact ecosystems are our most
            powerful — and most cost-effective — carbon sinks.
          </p>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- ====================================================
       GLOBAL CHALLENGES
       ==================================================== -->
  <section class="page-section" aria-labelledby="challenges-heading">
    <div class="container">
      <SectionHeader
        eyebrow="The Crisis Landscape"
        title="Current Global Challenges"
        subtitle="These four interlinked crises are converging at a pace that demands immediate, coordinated action."
        align="center"
      />
      <div class="challenges-grid" role="list">
        {
          challenges.map((c) => (
            <GlassCard class="challenge-card" role="listitem">
              <div class="challenge-icon" aria-hidden="true">
                {c.icon}
              </div>
              <h3 class="challenge-title">{c.label}</h3>
              <p class="challenge-body">{c.body}</p>
            </GlassCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ====================================================
       STAT COUNTERS
       ==================================================== -->
  <section class="page-section page-section--alt" aria-labelledby="stats-heading">
    <div class="container">
      <SectionHeader
        eyebrow="By the Numbers"
        title="The Scale of the Challenge"
        subtitle="These figures are drawn from peer-reviewed scientific reports and UN agencies. They are not projections — they describe the world today."
        align="center"
      />
      <div class="stats-grid" role="list">
        {
          stats.map((s) => (
            <GlassCard class="stat-card" role="listitem">
              <StatCounter
                value={s.value}
                decimals={s.decimals ?? 0}
                suffix={s.suffix}
                label={s.label}
              />
              <p class="stat-source">{s.note}</p>
            </GlassCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ====================================================
       SDG OVERVIEW
       ==================================================== -->
  <section class="page-section" aria-labelledby="sdg-heading">
    <div class="container">
      <SectionHeader
        eyebrow="United Nations · Agenda 2030"
        title="Sustainable Development Goals"
        subtitle={`The 17 SDGs were adopted by all 193 UN member states in 2015 as a universal call to action. The seven goals below are most directly tied to environmental sustainability — but they are interconnected with the full framework.`}
        align="center"
      />

      <!-- SDG intro note -->
      <GlassCard class="sdg-intro-card" strong>
        <p class="sdg-intro-text">
          <strong>About the 17 Global Goals:</strong> The Sustainable
          Development Goals (SDGs) — also called the Global Goals — form the
          core of the UN's 2030 Agenda for Sustainable Development. Adopted in
          September 2015, they build on the Millennium Development Goals (MDGs)
          and represent a shared blueprint for peace and prosperity for people
          and the planet. All 17 goals are interconnected: solving climate
          change requires action on energy, cities, and consumption; protecting
          biodiversity requires clean water and responsible land use. No goal
          stands alone.
        </p>
      </GlassCard>

      <div class="sdg-grid" role="list">
        {
          SDGS.map((sdg) => (
            <GlassCard class="sdg-card" role="listitem">
              <div class="sdg-number-badge" aria-hidden="true">
                {sdg.number}
              </div>
              <div class="sdg-content">
                <h3 class="sdg-title">
                  SDG {sdg.number}: {sdg.title}
                </h3>
                <p class="sdg-blurb">{sdg.blurb}</p>
              </div>
            </GlassCard>
          ))
        }
      </div>

      <p class="sdg-attribution">
        Source: United Nations,{" "}
        <a
          href="https://sdgs.un.org/goals"
          target="_blank"
          rel="noopener noreferrer"
          class="sdg-link"
        >
          sdgs.un.org/goals
        </a>
        . Official SDG titles used verbatim.
      </p>
    </div>
  </section>

  <!-- ====================================================
       CTA
       ==================================================== -->
  <section class="page-section page-section--cta" aria-labelledby="cta-heading">
    <div class="container cta-inner">
      <h2 id="cta-heading" class="cta-heading text-gradient">
        Ready to Explore Solutions?
      </h2>
      <p class="cta-body">
        Understanding the problem is the first step. TerraVision walks you
        through real sustainability solutions — from solar energy to rainwater
        harvesting — with interactive calculators and impact trackers.
      </p>
      <div class="cta-actions">
        <CTAButton href="/solutions" size="lg">Explore Solutions</CTAButton>
        <CTAButton href="/calculators" variant="secondary" size="lg">
          Try the Calculators
        </CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Layout helpers ─────────────────────────────────── */
  .container {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .page-section {
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }

  .page-section--alt {
    background: color-mix(in srgb, var(--surface-2) 60%, transparent);
  }

  /* ── Hero ───────────────────────────────────────────── */
  .about-hero {
    padding: clamp(4rem, 10vw, 7rem) clamp(1rem, 4vw, 2.5rem) clamp(2.5rem, 6vw, 4rem);
    text-align: center;
    display: flex;
    justify-content: center;
  }

  .about-hero-inner {
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .about-eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-green);
    margin: 0;
  }

  .about-hero-title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0;
  }

  .about-hero-subtitle {
    font-size: var(--text-body-lg);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 40rem;
    margin: 0;
    text-wrap: pretty;
  }

  /* ── Two-column (What Is Sustainability) ─────────────── */
  .two-col-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 48rem) {
    .two-col-layout {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .prose-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .prose-content p {
    color: var(--text-muted);
    line-height: 1.75;
    margin: 0;
  }

  .pillars-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .pillars-list li {
    color: var(--text-muted);
    line-height: 1.65;
    padding-left: 1rem;
    border-left: 2px solid var(--border-hairline);
  }

  .pillar-name {
    font-weight: 700;
  }

  .pillar-env { color: var(--color-green-deep); }
  .pillar-soc { color: var(--color-blue-deep); }
  .pillar-eco { color: var(--color-green); }

  [data-theme="dark"] .pillar-env { color: var(--color-green); }
  [data-theme="dark"] .pillar-soc { color: var(--color-blue); }
  [data-theme="dark"] .pillar-eco { color: var(--color-green); }

  .what-card {
    height: 100%;
  }

  .pull-quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pull-quote p {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
    margin: 0;
    text-wrap: pretty;
  }

  .pull-quote p::before { content: "\201C"; }
  .pull-quote p::after  { content: "\201D"; }

  .pull-quote footer {
    margin: 0;
  }

  .pull-quote cite {
    font-style: normal;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  /* ── Conservation grid ──────────────────────────────── */
  .conservation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem;
  }

  .cons-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cons-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .cons-title {
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .cons-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* ── Challenges grid ────────────────────────────────── */
  .challenges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .challenge-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform var(--dur-fast) var(--ease-out),
                box-shadow var(--dur-fast) var(--ease-out);
  }

  .challenge-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-glass), 0 8px 32px var(--shadow-ambient-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .challenge-card:hover {
      transform: none;
    }
  }

  .challenge-icon {
    font-size: 2.25rem;
    line-height: 1;
  }

  .challenge-title {
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .challenge-body {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* ── Stats grid ─────────────────────────────────────── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1.25rem;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .stat-source {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--text-subtle);
    font-style: italic;
  }

  /* ── SDG grid ───────────────────────────────────────── */
  .sdg-intro-card {
    margin-bottom: 2rem;
  }

  .sdg-intro-text {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.75;
    font-size: var(--text-sm);
  }

  .sdg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .sdg-card {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    align-items: flex-start;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .sdg-card:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .sdg-card:hover {
      transform: none;
    }
  }

  .sdg-number-badge {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background-image: var(--gradient-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--text-on-gradient);
    line-height: 1;
  }

  .sdg-content {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .sdg-title {
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }

  .sdg-blurb {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .sdg-attribution {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--text-subtle);
    text-align: center;
  }

  .sdg-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sdg-link:hover {
    color: var(--accent-deep);
  }

  /* ── CTA ────────────────────────────────────────────── */
  .page-section--cta {
    text-align: center;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .cta-body {
    font-size: var(--text-body-lg);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 38rem;
    margin: 0;
    text-wrap: pretty;
  }

  .cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>
