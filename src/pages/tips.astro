---
/**
 * Tips — TerraVision
 * 20 practical sustainability tips with an accessible category filter.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import CTAButton from "@/components/ui/CTAButton.astro";
import { SITE } from "@/data/site";
import { TIPS, TIP_CATEGORIES } from "@/data/tips";

const pageTitle = `20 Sustainability Tips — ${SITE.name}`;
const pageDescription =
  "Twenty simple, practical habits for students to save energy and water, cut waste, travel greener, and protect nature — small actions that add up to real impact.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="tips-hero" aria-labelledby="tips-heading">
    <div class="container hero-inner">
      <p class="eyebrow" aria-hidden="true">Everyday Action</p>
      <h1 id="tips-heading" class="hero-title ds-h1">
        20 <span class="text-gradient">Sustainability Tips</span>
      </h1>
      <p class="hero-subtitle">
        You don't need to change the world overnight. These twenty everyday
        habits are easy to start today — and when millions of students adopt
        them, the impact is enormous.
      </p>
    </div>
  </section>

  <section class="page-section" aria-labelledby="tips-grid-heading">
    <div class="container">
      <SectionHeader
        eyebrow="Pick a Theme"
        title="Filter by Category"
        subtitle="Choose a category to focus on, or view all twenty at once."
        align="center"
      />

      <!-- Category filter -->
      <div class="filter-bar" role="group" aria-label="Filter tips by category">
        <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">
          <span aria-hidden="true">✨</span> All
        </button>
        {
          TIP_CATEGORIES.map((c) => (
            <button type="button" class="filter-chip" data-filter={c.id} aria-pressed="false">
              <span aria-hidden="true">{c.icon}</span> {c.label}
            </button>
          ))
        }
      </div>

      <ul class="tips-grid" id="tips-grid" role="list">
        {
          TIPS.map((tip) => (
            <li class="tip-item" data-category={tip.category}>
              <GlassCard class="tip-card">
                <div class="tip-icon" aria-hidden="true">{tip.icon}</div>
                <div class="tip-body">
                  <div class="tip-head">
                    <span class="tip-num" aria-hidden="true">{String(tip.id).padStart(2, "0")}</span>
                    <h3 class="tip-title">{tip.title}</h3>
                  </div>
                  <p class="tip-detail">{tip.detail}</p>
                  <span class="tip-tag">{tip.category}</span>
                </div>
              </GlassCard>
            </li>
          ))
        }
      </ul>
      <p class="tips-empty" id="tips-empty" hidden>No tips in this category.</p>
    </div>
  </section>

  <section class="page-section page-section--cta" aria-labelledby="tips-cta">
    <div class="container cta-inner">
      <h2 id="tips-cta" class="cta-heading text-gradient">See Your Own Impact</h2>
      <p class="cta-body">
        Curious how much these habits actually save? Use our calculators to
        estimate your carbon, water and energy footprint.
      </p>
      <CTAButton href="/calculators" size="lg">Open the Calculators</CTAButton>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll(".filter-chip");
    var items = document.querySelectorAll(".tip-item");
    var empty = document.getElementById("tips-empty");
    chips.forEach(function (chip) {
      chip.addEventListener("click", function () {
        var filter = chip.getAttribute("data-filter");
        chips.forEach(function (c) {
          var active = c === chip;
          c.classList.toggle("is-active", active);
          c.setAttribute("aria-pressed", active ? "true" : "false");
        });
        var visible = 0;
        items.forEach(function (item) {
          var show = filter === "all" || item.getAttribute("data-category") === filter;
          item.hidden = !show;
          if (show) visible++;
        });
        if (empty) empty.hidden = visible !== 0;
      });
    });
  })();
</script>

<style>
  .container {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }
  .page-section { padding-block: clamp(2.5rem, 7vw, 4.5rem); }

  .tips-hero {
    padding: clamp(4rem, 10vw, 6.5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
  }
  .hero-inner { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-green);
    margin: 0;
  }
  .hero-title { font-family: var(--font-display); font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; margin: 0; }
  .hero-subtitle { font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.7; max-width: 42rem; margin: 0; text-wrap: pretty; }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-hairline);
    background: var(--glass-bg);
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .filter-chip:hover { color: var(--text); border-color: var(--color-green); }
  .filter-chip.is-active {
    color: var(--text-on-gradient);
    background-image: var(--gradient-brand);
    border-color: transparent;
  }
  .filter-chip:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }

  .tips-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }
  .tip-card { display: flex; gap: 1rem; height: 100%; }
  .tip-icon { font-size: 1.9rem; line-height: 1; flex-shrink: 0; }
  .tip-body { display: flex; flex-direction: column; gap: 0.5rem; }
  .tip-head { display: flex; align-items: baseline; gap: 0.5rem; }
  .tip-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-sm);
    color: transparent;
    background-image: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .tip-title { font-family: var(--font-display); font-size: var(--text-body-lg); font-weight: 700; color: var(--text); margin: 0; }
  .tip-detail { margin: 0; font-size: var(--text-sm); color: var(--text-muted); line-height: 1.7; }
  .tip-tag {
    align-self: flex-start;
    margin-top: auto;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--accent);
    padding-top: 0.4rem;
  }
  .tips-empty { text-align: center; color: var(--text-muted); margin-top: 2rem; }

  .page-section--cta { text-align: center; }
  .cta-inner { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .cta-heading { font-family: var(--font-display); font-size: var(--text-h2); font-weight: 800; letter-spacing: -0.03em; margin: 0; }
  .cta-body { font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.7; max-width: 36rem; margin: 0; text-wrap: pretty; }
</style>
