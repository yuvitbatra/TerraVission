---
/**
 * Resources — TerraVision
 * Downloadable / printable sustainability guides. Each guide is rendered as a
 * printable one-pager (print-to-PDF via the browser's print dialog).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { SITE } from "@/data/site";
import { GUIDES } from "@/data/resources";

const pageTitle = `Resource Library — ${SITE.name}`;
const pageDescription =
  "Free, printable sustainability guides — home energy savings, waste segregation, water conservation and a green-school starter kit. Print or save as PDF.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="rs-hero" aria-labelledby="rs-heading">
    <div class="container hero-inner">
      <p class="eyebrow" aria-hidden="true">Take It With You</p>
      <h1 id="rs-heading" class="hero-title ds-h1">Resource <span class="text-gradient">Library</span></h1>
      <p class="hero-subtitle">
        Handy guides you can read here, print out, or save as a PDF to share at
        home and school. Use the print button on any guide to save it.
      </p>
    </div>
  </section>

  <section class="page-section" aria-labelledby="guides-heading">
    <div class="container">
      <SectionHeader eyebrow="Download & Print" title="Sustainability Guides" align="center" />
      <div class="guides">
        {
          GUIDES.map((g) => (
            <GlassCard class="guide-card" id={`guide-${g.id}`}>
              <div class="guide-head">
                <span class="guide-icon" aria-hidden="true">{g.icon}</span>
                <div>
                  <span class="guide-cat">{g.category}</span>
                  <h3 class="guide-title">{g.title}</h3>
                </div>
              </div>
              <p class="guide-summary">{g.summary}</p>
              <div class="guide-content">
                {g.sections.map((s) => (
                  <div class="guide-section">
                    <h4 class="guide-section-title">{s.heading}</h4>
                    <ul class="guide-points">
                      {s.points.map((p) => <li>{p}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
              <button type="button" class="print-btn" data-print={`guide-${g.id}`}>
                <span aria-hidden="true">🖨️</span> Print / Save as PDF
              </button>
            </GlassCard>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    document.querySelectorAll(".print-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.getAttribute("data-print");
        document.body.setAttribute("data-printing", id);
        window.print();
        setTimeout(function () { document.body.removeAttribute("data-printing"); }, 500);
      });
    });
  })();
</script>

<style>
  .container { max-width: 72rem; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 2.5rem); }
  .page-section { padding-block: clamp(2.5rem, 7vw, 4.5rem); }

  .rs-hero { padding: clamp(4rem, 10vw, 6.5rem) 0 clamp(1.5rem, 4vw, 2.5rem); text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .eyebrow { font-family: var(--font-display); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-green); margin: 0; }
  .hero-title { font-family: var(--font-display); font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; margin: 0; }
  .hero-subtitle { font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.7; max-width: 42rem; margin: 0; }

  .guides { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); gap: 1.5rem; }
  .guide-card { display: flex; flex-direction: column; gap: 1rem; }
  .guide-head { display: flex; gap: 0.9rem; align-items: center; }
  .guide-icon { font-size: 2rem; line-height: 1; }
  .guide-cat { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; color: var(--accent); }
  .guide-title { font-family: var(--font-display); font-size: var(--text-h3); font-weight: 700; color: var(--text); margin: 0.1rem 0 0; }
  .guide-summary { margin: 0; font-size: var(--text-sm); color: var(--text-muted); line-height: 1.6; }
  .guide-content { display: flex; flex-direction: column; gap: 0.9rem; }
  .guide-section-title { font-family: var(--font-display); font-size: var(--text-body); font-weight: 700; color: var(--text); margin: 0 0 0.35rem; }
  .guide-points { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .guide-points li { font-size: var(--text-sm); color: var(--text-muted); line-height: 1.55; }

  .print-btn {
    align-self: flex-start;
    margin-top: auto;
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-hairline);
    background: var(--glass-bg);
    color: var(--text);
    font-family: var(--font-display); font-weight: 600; font-size: var(--text-sm);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .print-btn:hover { border-color: var(--color-green); color: var(--color-green-deep); }
  .print-btn:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }

  /* Print: when a specific guide is being printed, show only that guide cleanly. */
  @media print {
    :global(body[data-printing]) :global(.ecobot-btn),
    :global(body[data-printing]) :global(nav),
    :global(body[data-printing]) :global(footer),
    .rs-hero, .print-btn { display: none !important; }
    .guide-card { box-shadow: none; border: 1px solid #ccc; break-inside: avoid; }
  }
</style>
