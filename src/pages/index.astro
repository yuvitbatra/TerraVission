---
// TerraVision — Home (placeholder hero; full page built in a later task)
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/data/site";
---

<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.defaultDescription}>
  <!-- Minimal hero placeholder -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">Sustainability Education</p>
      <h1 class="hero-title">
        <span class="text-gradient">{SITE.name}</span>
      </h1>
      <p class="hero-tagline">{SITE.tagline}</p>
      <p class="hero-desc">{SITE.defaultDescription}</p>
      <div class="hero-actions">
        <a href="/solutions" class="hero-cta-primary">Explore Solutions</a>
        <a href="/about" class="hero-cta-ghost">Learn More</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - 3.75rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4rem, 10vw, 8rem) clamp(1rem, 4vw, 2.5rem);
    text-align: center;
  }

  .hero-inner {
    max-width: 44rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-green);
    margin: 0;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0;
  }

  .hero-tagline {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--text-muted);
    margin: 0;
  }

  .hero-desc {
    font-size: var(--text-body-lg);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 38rem;
    margin: 0;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.75rem;
  }

  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius-full);
    background-image: var(--gradient-brand);
    color: var(--text-on-gradient);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-green) 35%, transparent);
  }

  .hero-cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-green) 45%, transparent);
  }

  .hero-cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .hero-cta-ghost:hover {
    background: var(--surface-2);
    color: var(--text);
  }
</style>
