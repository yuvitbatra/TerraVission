---
/**
 * Timeline — TerraVision
 * Evolution of renewable energy (alternating glass timeline) + future roadmap.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import CTAButton from "@/components/ui/CTAButton.astro";
import { SITE } from "@/data/site";
import { MILESTONES, ROADMAP } from "@/data/timeline";

const pageTitle = `Timeline of Renewable Energy — ${SITE.name}`;
const pageDescription =
  "From the 1839 discovery of the photovoltaic effect to a net-zero future — trace the key milestones in the evolution of renewable energy and the road ahead.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="tl-hero" aria-labelledby="tl-heading">
    <div class="container hero-inner">
      <p class="eyebrow" aria-hidden="true">A Journey Through Time</p>
      <h1 id="tl-heading" class="hero-title ds-h1">
        The Evolution of <span class="text-gradient">Renewable Energy</span>
      </h1>
      <p class="hero-subtitle">
        Clean energy is not new — people have harnessed sun, wind and water for
        centuries. This timeline follows the breakthroughs that built today's
        renewable revolution, and the goals guiding what comes next.
      </p>
    </div>
  </section>

  <section class="page-section" aria-labelledby="milestones-heading">
    <div class="container">
      <SectionHeader eyebrow="History" title="Key Milestones" align="center" />
      <ol class="timeline" role="list">
        {
          MILESTONES.map((m, i) => (
            <li class={`tl-item ${i % 2 === 0 ? "tl-left" : "tl-right"}`}>
              <div class="tl-marker" aria-hidden="true"></div>
              <GlassCard class="tl-card">
                <span class="tl-year">{m.year}</span>
                <h3 class="tl-title">{m.title}</h3>
                <p class="tl-detail">{m.detail}</p>
              </GlassCard>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="page-section page-section--alt" aria-labelledby="roadmap-heading">
    <div class="container">
      <SectionHeader
        eyebrow="Looking Ahead"
        title="The Road to Net Zero"
        subtitle="Targets agreed by governments and scientists to keep global warming in check."
        align="center"
      />
      <div class="roadmap-grid" role="list">
        {
          ROADMAP.map((r) => (
            <GlassCard class="roadmap-card" role="listitem" strong>
              <span class="roadmap-period">{r.period}</span>
              <p class="roadmap-goal">{r.goal}</p>
            </GlassCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section page-section--cta" aria-labelledby="tl-cta">
    <div class="container cta-inner">
      <h2 id="tl-cta" class="cta-heading text-gradient">See the Numbers Today</h2>
      <p class="cta-body">Explore live data on how fast renewables are growing right now.</p>
      <CTAButton href="/impact" size="lg">View Global Impact</CTAButton>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 72rem; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 2.5rem); }
  .page-section { padding-block: clamp(2.5rem, 7vw, 4.5rem); }
  .page-section--alt { background: color-mix(in srgb, var(--surface-2) 60%, transparent); }

  .tl-hero { padding: clamp(4rem, 10vw, 6.5rem) 0 clamp(1.5rem, 4vw, 2.5rem); text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .eyebrow { font-family: var(--font-display); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-green); margin: 0; }
  .hero-title { font-family: var(--font-display); font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; margin: 0; }
  .hero-subtitle { font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.7; max-width: 44rem; margin: 0; text-wrap: pretty; }

  /* Timeline */
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before {
    content: "";
    position: absolute;
    left: 1rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background-image: var(--gradient-brand);
    opacity: 0.5;
  }
  .tl-item { position: relative; padding-left: 3rem; margin-bottom: 1.5rem; }
  .tl-marker {
    position: absolute;
    left: calc(1rem - 6px);
    top: 1.4rem;
    width: 14px;
    height: 14px;
    border-radius: var(--radius-full);
    background-image: var(--gradient-brand);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-green) 20%, transparent);
  }
  .tl-card { display: flex; flex-direction: column; gap: 0.4rem; }
  .tl-year {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-body-lg);
    color: transparent;
    background-image: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .tl-title { font-family: var(--font-display); font-size: var(--text-body-lg); font-weight: 700; color: var(--text); margin: 0; }
  .tl-detail { margin: 0; font-size: var(--text-sm); color: var(--text-muted); line-height: 1.7; }

  /* Alternating layout on wide screens */
  @media (min-width: 52rem) {
    .timeline::before { left: 50%; transform: translateX(-1px); }
    .tl-item { width: 50%; padding-left: 0; }
    .tl-left { left: 0; padding-right: 2.5rem; text-align: right; }
    .tl-right { left: 50%; padding-left: 2.5rem; }
    .tl-left .tl-marker { left: auto; right: -7px; }
    .tl-right .tl-marker { left: -7px; }
    .tl-left .tl-card { align-items: flex-end; }
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem;
  }
  .roadmap-card { display: flex; flex-direction: column; gap: 0.6rem; text-align: center; align-items: center; }
  .roadmap-period {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-h3);
    color: transparent;
    background-image: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .roadmap-goal { margin: 0; font-size: var(--text-sm); color: var(--text-muted); line-height: 1.7; }

  .page-section--cta { text-align: center; }
  .cta-inner { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .cta-heading { font-family: var(--font-display); font-size: var(--text-h2); font-weight: 800; letter-spacing: -0.03em; margin: 0; }
  .cta-body { font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.7; max-width: 36rem; margin: 0; }
</style>
