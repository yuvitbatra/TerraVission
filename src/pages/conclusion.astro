---
/**
 * Conclusion — TerraVision
 * "Together We Can Build a Sustainable Future" — summary + call to action.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import CTAButton from "@/components/ui/CTAButton.astro";
import { SITE } from "@/data/site";

const pageTitle = `Conclusion — ${SITE.name}`;
const pageDescription =
  "Together we can build a sustainable future. A summary of what we have learned about clean energy, conservation and the everyday actions that protect our planet.";

const takeaways = [
  { icon: "☀️", text: "Renewable energy — solar, wind, hydro — can power our world without warming it." },
  { icon: "💧", text: "Conserving and purifying water protects the most precious resource of all." },
  { icon: "♻️", text: "Reducing, reusing and recycling keeps waste out of our land, rivers and oceans." },
  { icon: "🌱", text: "Small daily habits, multiplied by millions of people, create enormous change." },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="cn-hero" aria-labelledby="cn-heading">
    <div class="container hero-inner">
      <p class="eyebrow" aria-hidden="true">The Road Ahead</p>
      <h1 id="cn-heading" class="hero-title ds-h1">
        Together We Can Build a <span class="text-gradient">Sustainable Future</span>
      </h1>
      <p class="hero-subtitle">
        The challenges are real — but so are the solutions. Every technology in
        this project already exists and works today. What it takes now is
        awareness, effort, and people willing to act. That includes you.
      </p>
    </div>
  </section>

  <section class="page-section" aria-labelledby="takeaway-heading">
    <div class="container">
      <SectionHeader eyebrow="What We Learned" title="The Big Ideas" align="center" />
      <div class="takeaway-grid" role="list">
        {
          takeaways.map((t) => (
            <GlassCard class="takeaway-card" role="listitem">
              <span class="takeaway-icon" aria-hidden="true">{t.icon}</span>
              <p class="takeaway-text">{t.text}</p>
            </GlassCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section page-section--alt" aria-labelledby="pledge-heading">
    <div class="container narrow">
      <GlassCard class="pledge-card" strong>
        <h2 id="pledge-heading" class="pledge-title">Our Pledge</h2>
        <p class="pledge-text">
          Protecting the Earth is not the job of governments and scientists
          alone. It begins at home and in school — with the bulb we switch off,
          the water we save, the tree we plant and the waste we sort. If each of
          us takes responsibility for our own footprint, the combined effect can
          heal the planet for generations to come.
        </p>
        <p class="pledge-sign">— The TerraVision Team</p>
      </GlassCard>
    </div>
  </section>

  <section class="page-section page-section--cta" aria-labelledby="cn-cta">
    <div class="container cta-inner">
      <h2 id="cn-cta" class="cta-heading text-gradient">Take the First Step</h2>
      <p class="cta-body">Test your knowledge, measure your impact, and pick a habit to start today.</p>
      <div class="cta-actions">
        <CTAButton href="/quiz" size="lg">Take the Quiz</CTAButton>
        <CTAButton href="/calculators" variant="secondary" size="lg">Measure My Impact</CTAButton>
        <CTAButton href="/tips" variant="ghost" size="lg">Browse Tips</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 72rem; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 2.5rem); }
  .container.narrow { max-width: 48rem; }
  .page-section { padding-block: clamp(2.5rem, 7vw, 4.5rem); }
  .page-section--alt { background: color-mix(in srgb, var(--surface-2) 60%, transparent); }

  .cn-hero { padding: clamp(4rem, 10vw, 7rem) 0 clamp(1.5rem, 4vw, 2.5rem); text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .eyebrow { font-family: var(--font-display); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-green); margin: 0; }
  .hero-title { font-family: var(--font-display); font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin: 0; }
  .hero-subtitle { font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.7; max-width: 44rem; margin: 0; text-wrap: pretty; }

  .takeaway-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: 1.25rem; }
  .takeaway-card { display: flex; gap: 0.9rem; align-items: flex-start; }
  .takeaway-icon { font-size: 1.8rem; line-height: 1; flex-shrink: 0; }
  .takeaway-text { margin: 0; font-size: var(--text-body); color: var(--text-muted); line-height: 1.6; }

  .pledge-card { text-align: center; display: flex; flex-direction: column; gap: 1rem; }
  .pledge-title { font-family: var(--font-display); font-size: var(--text-h2); font-weight: 800; color: var(--text); margin: 0; }
  .pledge-text { margin: 0; font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.75; text-wrap: pretty; }
  .pledge-sign { margin: 0; font-family: var(--font-display); font-weight: 700; color: var(--accent); }

  .page-section--cta { text-align: center; }
  .cta-inner { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .cta-heading { font-family: var(--font-display); font-size: var(--text-h2); font-weight: 800; letter-spacing: -0.03em; margin: 0; }
  .cta-body { font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.7; max-width: 36rem; margin: 0; }
  .cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; }
</style>
