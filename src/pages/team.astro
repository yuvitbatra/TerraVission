---
/**
 * Team — TerraVision
 * Project team member cards + clearly-labelled Class/School/Teacher placeholders.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { SITE, TEAM, PLACEHOLDERS } from "@/data/site";

const pageTitle = `Our Team — ${SITE.name}`;
const pageDescription =
  "Meet the student team behind TerraVision — a science-exhibition project on sustainability, green technology and protecting the Earth.";

const roles = [
  "Research & Content",
  "Design & Visuals",
  "Development & Data",
  "Diagrams & Illustration",
  "Presentation & Coordination",
];

const members = TEAM.map((m, i) => ({
  name: m.name,
  role: roles[i % roles.length],
  initials: m.name.slice(0, 1).toUpperCase(),
}));
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="tm-hero" aria-labelledby="tm-heading">
    <div class="container hero-inner">
      <p class="eyebrow" aria-hidden="true">Behind the Project</p>
      <h1 id="tm-heading" class="hero-title ds-h1">
        Meet the <span class="text-gradient">TerraVision Team</span>
      </h1>
      <p class="hero-subtitle">
        We are a team of students passionate about science, technology and the
        environment. We built this project to share how sustainable solutions
        can create a cleaner, greener future for everyone.
      </p>
    </div>
  </section>

  <section class="page-section" aria-labelledby="members-heading">
    <div class="container">
      <SectionHeader eyebrow="The People" title="Our Members" align="center" />
      <div class="team-grid" role="list">
        {
          members.map((m) => (
            <GlassCard class="member-card" role="listitem">
              <div class="member-avatar" aria-hidden="true">{m.initials}</div>
              <h3 class="member-name">{m.name}</h3>
              <p class="member-role">{m.role}</p>
            </GlassCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section page-section--alt" aria-labelledby="project-heading">
    <div class="container narrow">
      <SectionHeader eyebrow="Project Details" title="About This Submission" align="center" />
      <GlassCard class="project-card" strong>
        <dl class="project-info">
          <div class="info-row">
            <dt>Class</dt>
            <dd class="placeholder">{PLACEHOLDERS.class}</dd>
          </div>
          <div class="info-row">
            <dt>School Name</dt>
            <dd class="placeholder">{PLACEHOLDERS.school}</dd>
          </div>
          <div class="info-row">
            <dt>Teacher / Guide</dt>
            <dd class="placeholder">{PLACEHOLDERS.teacher}</dd>
          </div>
        </dl>
        <p class="project-note">
          ℹ️ The fields above are placeholders — replace them with your class,
          school name and teacher's name before presenting.
        </p>
      </GlassCard>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 72rem; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 2.5rem); }
  .container.narrow { max-width: 44rem; }
  .page-section { padding-block: clamp(2.5rem, 7vw, 4.5rem); }
  .page-section--alt { background: color-mix(in srgb, var(--surface-2) 60%, transparent); }

  .tm-hero { padding: clamp(4rem, 10vw, 7rem) 0 clamp(1.5rem, 4vw, 2.5rem); text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .eyebrow { font-family: var(--font-display); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-green); margin: 0; }
  .hero-title { font-family: var(--font-display); font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; margin: 0; }
  .hero-subtitle { font-size: var(--text-body-lg); color: var(--text-muted); line-height: 1.7; max-width: 44rem; margin: 0; text-wrap: pretty; }

  .team-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: 1.25rem; }
  .member-card { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.6rem; }
  .member-avatar {
    width: 4rem; height: 4rem;
    border-radius: var(--radius-full);
    background-image: var(--gradient-brand);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; font-size: var(--text-h3);
    color: var(--text-on-gradient);
  }
  .member-name { font-family: var(--font-display); font-size: var(--text-body-lg); font-weight: 700; color: var(--text); margin: 0; }
  .member-role { margin: 0; font-size: var(--text-sm); color: var(--text-muted); }

  .project-card { display: flex; flex-direction: column; gap: 1.25rem; }
  .project-info { margin: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .info-row { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; border-bottom: 1px solid var(--border-hairline); padding-bottom: 0.6rem; }
  .info-row dt { font-family: var(--font-display); font-weight: 700; color: var(--text); }
  .info-row dd { margin: 0; }
  .placeholder {
    font-style: italic;
    color: var(--text-subtle);
    border: 1px dashed var(--border-hairline);
    border-radius: var(--radius-sm, 0.5rem);
    padding: 0.2rem 0.6rem;
  }
  .project-note { margin: 0; font-size: var(--text-sm); color: var(--text-muted); text-align: center; }
</style>
